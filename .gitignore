node_modules/
node_modules
service-account-key.json
.env
# Timestamped .env snapshots taken before deploys/config changes. These hold the
# SAME live secrets as .env (session secret, webhook tokens, API keys), so they
# must never be committable — they were untracked-but-stageable until 2026-08-06.
.env.bak*
.env.*.bak

# Vue / Vite
client/dist/
client/node_modules/
client/node_modules

# SQLite database files (contain PII — never commit)
app.db
app.db-shm
app.db-wal
app.db.bak*
app.db.docgen*
app.db.production*
app.db.prod-capture*
# The database the PREVIOUS one is renamed to every time scripts/refresh-local.sh
# runs — see refresh-env.js, "previous database moved to app.db.pre-refresh-<ts>".
# It was NOT matched by any rule above (`app.db.bak*` does not cover it), so it
# sat in `git status` as plain untracked: one `git add -A` would have committed a
# ~300 MB database. Every refresh mints another, and the refresh is the documented
# way to get production-shaped data locally — so this is a routine artifact, not
# an exotic one. Found 2026-08-13 while shipping the refusal-audit batch.
app.db.pre-refresh*
logisxdb.db
# Temp copies written by GET /api/db/download. These are FULL database dumps —
# every SSN, routing and account number — and the name does not start with
# "app.db", so none of the rules above match it. It now writes to os.tmpdir()
# instead of __dirname; this rule is the second guard, kept because a single
# stray copy in the working tree is a whole-database leak.
app_backup*.db

# Production/staging DB snapshots pulled down for screenshot capture
scripts/docs/app.db.*

# User uploads (PII — receipts, photos, signed docs)
# Runtime data only. Do NOT track anything under here: a tracked file inside an
# ignored tree survives `git add` but not `rm -rf uploads`, and `git check-ignore`
# reports it as "not ignored" (it skips tracked files), so the trap is invisible.
# The six onboarding template PDFs used to sit here and were twice deleted by a
# routine cleanup — they now live in onboarding-templates/pdf/. See that README.
uploads/

# Superseded signed legal documents (PII — tax ids, bank routing/account).
# Deliberately OUTSIDE uploads/ so express.static can never reach it: these are
# the originals a force-regenerate replaced, kept as evidence, and the only way
# to read one is on the box. Same "runtime data only, track nothing" rule as
# uploads/ above, and for a strictly worse payload.
evidence-archive/

# Local backups and ad-hoc test artifacts
attachments/
*.bak
*.bak2
scripts/.wf-backup-*.json

# Claude
.claude/
.claude*

# Personal daily-timeline / invoice artifacts (billing records, not code)
docs/*timeline*.docx
docs/*timeline*.html
scripts/generate-timeline*.py

# Local-only secrets (keep on disk, never commit)
.env.local
google-maps-api-key.txt

# One-off diagnostic / helper scripts + output (kept locally, not part of the repo)
.diag-n8n/
scripts/copy-prod-sheet.js
scripts/diag-bison-ratecon.js
scripts/diag-ratecon-folder.js
scripts/driver-load-statuses.js
scripts/find-load-row.js
scripts/replay-driver.js
scripts/search-gmail-for-load.js

# Browser-automation artifacts (Playwright MCP runs) — local only, never deploy
.playwright-mcp/

# Ad-hoc screenshots dropped at the repo root (keep tracked assets like logo.png)
/*.png
!/logo.png

# Local DB snapshots written by backup.sh (gigabytes). Never committable.
backups/

# Rendered investor payout statement PDFs (cache for GET …/statement).
# Deliberately OUTSIDE uploads/ so express.static can never reach them — the
# API route is the only reader. Runtime data: regenerated on demand, so losing
# the directory costs one re-render. Same "track nothing under here" rule as
# uploads/ and evidence-archive/ above.
storage/
