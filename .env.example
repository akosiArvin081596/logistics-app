# LogisX environment template.
# Copy this file to .env and fill in real values. The live .env is git-ignored;
# this template is checked in so the team knows which keys exist.

# --- Server ---
PORT=3000
SESSION_SECRET=change-me-in-production

# --- Parallel-dev port overrides (per-worktree, optional) ---
# When running multiple worktrees side-by-side, give each its own ports.
# VITE_DEV_PORT is the Vite dev server port; VITE_API_TARGET is the Express
# backend that Vite proxies /api and /socket.io to. Leave both unset for the
# default 5173 → http://localhost:3000 pairing.
# VITE_DEV_PORT=5173
# VITE_API_TARGET=http://localhost:3000

# --- Google Sheets / Drive / Maps ---
# Spreadsheet IDs. Leave unset to use the production sheets; override in
# staging (or any non-prod env) to point at a separate copy. The service
# account (sheets-bot@logistics-app-491014.iam.gserviceaccount.com) must be
# shared on whichever sheet you point at.
SPREADSHEET_ID=
ARCHIVE_SPREADSHEET_ID=
# Drive folder ID for POD uploads. Optional — uploads skip Drive when empty.
GOOGLE_DRIVE_FOLDER_ID=
# Required for the dashboard maps, route directions, geocoding, and the diesel
# truck-stop POI layer on the tracking map (GET /api/poi/fuel-stops).
GOOGLE_MAPS_API_KEY=

# --- Email (driver onboarding + investor outreach) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Gemini Vision (expense receipt OCR) ---
# Optional. When unset, the receipt-OCR endpoint returns 503 and the driver
# form silently falls back to manual entry.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Routemate ELD/telematics integration ---
# Base URL is the production Routemate cloud. Override only for sandbox use.
ROUTEMATE_BASE_URL=https://cloud.routemate.ai
# Issued by Routemate. Sent as the X-Api-Key header on every request.
ROUTEMATE_API_KEY=
# Master kill switch. Leave false until the API key is wired and at least one
# truck is linked to a Routemate vehicle. When false, all sync intervals are
# dormant and the manual probe (POST /api/admin/routemate/sync-now) returns 503.
ROUTEMATE_ENABLED=false
# Polling cadences (used in Phase 2+; harmless when ROUTEMATE_ENABLED=false).
ROUTEMATE_POLL_LIVE_SEC=60
ROUTEMATE_POLL_FAULTS_SEC=300
ROUTEMATE_POLL_DAILY_HOUR=4

# --- Linxup GPS / telematics (webhook push) ---
# Linxup is the fleet GPS provider. Unlike the Routemate poller, Linxup PUSHES
# telemetry to us: it POSTs each message to /api/eld/linxup/webhook — we never
# poll Linxup, so there is no base URL or poll cadence here.
# Master write switch. Leave false until the token is set and a real push has
# been verified. When false the webhook still ALWAYS enforces the token gate, but
# pushed positions are recognized/counted only, never written to live tracking or
# driver pay — so the feature ships dormant (matches ROUTEMATE_ENABLED).
LINXUP_ENABLED=false
# Shared secret Linxup presents on every push. The receiver accepts it as
# Authorization: Bearer <token>, X-Api-Key, X-Webhook-Token, or X-Linxup-Token
# header, or a ?token= query param. Blank → the webhook returns 503 (not
# configured). Never commit a real value.
LINXUP_WEBHOOK_TOKEN=
# Unit of the `speed` field on pushed Position messages; converted to m/s on
# ingest (downstream/tracking + the driver-pay travel gate expect m/s).
# mph | kmh | mps (default mph — US provider). LIVE-CAPTURE: confirm on 1st push.
LINXUP_SPEED_UNIT=mph

# --- ScanKit.io document scanning ---
# Powers the document scanner (driver POD/BOL, expense receipts, admin uploads)
# via POST /api/documents/scan — server-side only, never exposed to the client.
# Base URL is the production ScanKit API; override only for sandbox use.
SCANKIT_BASE_URL=https://api.scankit.io
# Issued by ScanKit (format sk_...). Sent as the Authorization: Bearer header.
SCANKIT_API_KEY=
# Master kill switch. Leave false until the API key is wired. When false (or the
# key is unset), POST /api/documents/scan returns 503 and the client scanner
# falls back to attaching the raw photo (receipts simply skip enhancement).
SCANKIT_ENABLED=false
# ScanKit is credit-billed: charged per successful scan (HTTP 2xx); 4xx errors
# like 402 are NOT billed and NOT retried. When credits run out the scan endpoint
# returns 402 and the driver app falls back to attaching the raw photo — the POD
# still uploads, just without crop/deskew/lighting enhancement. Setting
# SCANKIT_ENABLED=false fully disables scanning (endpoint returns 503 + the same
# raw-photo fallback). Recovery / credit top-up / key-rotation runbook:
# docs/runbooks/scankit-billing.md

# --- Automatic weekly invoice generation ---------------------------------
# Master kill switch for the Friday 4:00 PM America/New_York (DST-aware) batch
# that generates AND auto-submits every driver's weekly invoice (drivers kept
# forgetting to submit). Approval stays manual — nothing is auto-approved/paid.
# DEFAULT OFF (this moves money): stays dormant until explicitly enabled here,
# matching ROUTEMATE_ENABLED / SCANKIT_ENABLED. Enable with true/1/yes/on.
# On first enable it seeds a baseline so it never retroactively bills a past
# week — the first real run is the next Friday. A boot catch-up covers a restart
# across 4 PM; a week with drivers who worked-but-weren't-billed retries (bounded)
# and emails/notifies info@logisx.com with an ACTION-NEEDED summary.
INVOICE_AUTOGEN_ENABLED=false

# --- Rate-con reconciliation (ingestion backstop) -------------------------
# Answers, from OUTSIDE the pipeline: did every rate-con email actually become a
# load? On 2026-08-05 two loads reached the mailbox and never reached the sheet —
# one during a Gemini outage, one because an n8n Filter node discarded a bad
# extraction with NO alert while still reporting success. Both were found by hand.
# Alerting on n8n's reject branch makes KNOWN failures loud; this catches the ones
# nobody has thought of (execution never starts, Gmail filter stops matching, n8n
# outage, workflow left deactivated) because it only compares email vs sheet.
#
# READ-ONLY on the mailbox (IMAP EXAMINE + BODY.PEEK): it must never set \Seen or
# \Flagged — n8n's Gmail Trigger selects on unread+starred, so a sweep that marked
# mail read would silently stop ingestion, i.e. cause the outage it detects.
# Alerts ONCE per load id, because a daily repeat of the same gap trains everyone
# to ignore the channel. Runs every 6h; also on demand via
# GET /api/admin/ratecon-reconcile (?dryRun=true reports without alerting).
# DEFAULT OFF, matching the other side-effectful integrations.
RATECON_RECONCILE_ENABLED=false
RATECON_RECONCILE_DAYS=14
RATECON_RECONCILE_MAILBOX=RATECONs

# --- Monthly settlement close (investor payouts) --------------------------
# Master kill switch for the month-end close: a work month stays open for
# straggler receipts for `settlement_grace_days` (investor_config, default 7)
# after it ends, then finalizes automatically — freezing the payout figure and
# publishing the statement. Late receipts land in the prior month by themselves
# during the window instead of needing a hand-written adjustment; a receipt that
# misses it posts to the current open month and the closed month never moves.
# DEFAULT OFF (this freezes money figures and publishes documents): with it off,
# every guard is inert and the payout ledger behaves exactly as before.
# Enable with true/1/yes/on.
# On first enable it seeds a baseline lock over every period whose window has
# already passed, so nothing is retroactively re-opened and no month that is
# still legitimately inside its window gets closed early.
# Blocks "Mark Paid" until a period is finalized (that block is what ends the
# correction treadmill); reopening a settled payout stays exempt.
PERIOD_FINALIZE_ENABLED=false
