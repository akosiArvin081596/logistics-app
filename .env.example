# LogisX environment template.
# Copy this file to .env and fill in real values. The live .env is git-ignored;
# this template is checked in so the team knows which keys exist.

# --- Server ---
# Interface the server binds to. Defaults to 127.0.0.1 (loopback ONLY) so the
# app is reachable exclusively through nginx. Do not set this to 0.0.0.0 on a
# public host: it bypasses TLS, every nginx security header, and — because
# `trust proxy` is on — makes every IP-keyed rate limiter forgeable.
BIND_HOST=127.0.0.1
PORT=3000
SESSION_SECRET=change-me-in-production

# The business time zone (lib/app-time.js): every "today" and current month, the
# Sat-Fri invoice week of "now", the Friday 6:30 PM driver cutoff, the Friday
# 7:00 PM batch, the month close, the Assigned / Status Update stamps written into
# the sheet, the dates invoices, statements and reports print (a signed contract's
# effective date keeps its UTC day, so a re-render matches what was signed), and
# every time shown with a zone label.
# The browser gets it from GET /api/auth/session. An IANA region name or UTC;
# unset, America/New_York (US Eastern, the client's decision of 2026-10-08; EST and
# EDT follow the zone database). Never the server's clock: production runs in UTC,
# where "today" is already tomorrow from 8 PM Eastern (7 PM in winter). Anything
# else (a name the runtime does not know, or an offset or abbreviation such as
# -0400 or EST, which never follows daylight time) falls back to the default with
# one boot warning. Bare YYYY-MM-DD dates (load dates, invoice weeks) are calendar
# dates and never pass through it, and stamps already in the sheet keep the day
# written on them. A driver's worked day is still the truck's local day (where
# the truck was), not this zone.
# APP_TIMEZONE=America/New_York

# Set to "production" on a deployed server. Read at session setup in server.js,
# and only that exact string counts: it makes SESSION_SECRET mandatory (boot
# throws without it) and marks the session cookie Secure, which a
# SESSION_COOKIE_SAMESITE of "none" requires. Unset (the default) or anything
# else is dev behaviour: a dev-only fallback secret with a boot warning, and a
# cookie that is not Secure. Keep it commented in a local .env — a browser never
# stores a Secure cookie over plain http, so "production" on http://localhost
# means no login ever sticks.
# NODE_ENV=production

# SQLite database file, opened once at boot (`new Database(...)` near the top of
# server.js); the session store lives in it too. Default: app.db beside
# server.js. Use an ABSOLUTE path — a relative one resolves against the process's
# working directory, not the repo. uploads/ does not move with it.
# ⚠️ The nightly backup and the refresh scripts do NOT read this: backup.sh and
# refresh-local.sh / refresh-staging.sh all name <app dir>/app.db explicitly, so
# pointing a deployed server elsewhere leaves them working on the old file.
# DATABASE_PATH=/absolute/path/to/app.db

# --- Session cookie SameSite (normally UNSET — unset means "lax") ---
# SameSite is the single attribute deciding whether a browser attaches the
# session cookie to a request some OTHER site made, so it is the whole CSRF
# question. Production ran "none" from 2026-05-17 for a driver-mobile-view
# prototype that was never in this repo and is set up nowhere; it was tightened
# to "lax" on 2026-08-09.
#
# Leave this UNSET. "lax" still carries the cookie on a top-level cross-site GET
# navigation, so links in onboarding/outreach email, bookmarks and QR codes all
# still land logged in — while cross-site POSTs, cross-origin fetches and every
# subresource load (<img>, <iframe>) no longer carry it.
#
# Values: lax (default) | strict | none
#   strict — a user following a link from an email or an external site lands
#            LOGGED OUT. Almost certainly not what you want here.
#   none   — reopens the CSRF class app-wide. There is no CSRF token in this
#            app, so only the per-route crossSiteGuard mounts would remain.
#            REQUIRES a Secure cookie (NODE_ENV=production); it is refused and
#            downgraded to "lax" otherwise, because browsers reject None without
#            Secure and the cookie would be dropped entirely — i.e. every user
#            logged out on every request. Set it only alongside
#            DRIVER_MOBILE_ORIGINS, to serve a genuine cross-origin browser
#            client. Both are needed; neither alone is enough.
# Anything unrecognized falls back to "lax". Every non-default choice warns at
# boot. This exists as the one-line, no-deploy way back from a bad tightening
# (set it, pm2 restart) — it is a rollback switch, not a feature flag.
# SESSION_COOKIE_SAMESITE=lax

# --- Cross-origin browser clients (normally UNSET, and should stay that way) ---
# Comma-separated origin allowlist that receives permissive CORS headers,
# including Access-Control-Allow-Credentials. DEFAULTS TO EMPTY: no cross-origin
# browser client. It used to default to "https://localhost:3002,
# https://192.168.8.106:3002", which shipped to production and was worse than
# dead weight — that list is also the FIRST leg of crossSiteGuard, so those two
# dev addresses were a standing bypass of the guards on the four money routes.
# Setting this alone does NOT re-enable a credentialed cross-origin client; the
# cookie is SameSite=lax, so SESSION_COOKIE_SAMESITE=none is required too.
# DRIVER_MOBILE_ORIGINS=

# --- First-time setup recovery (normally UNSET, and should stay that way) ---
# POST /api/auth/setup creates the very first Super Admin with no authentication.
# It is refused once accounts exist, and ALSO refused when `users` is empty but
# the database still carries a live system's data (expenses / trucks / settled
# payouts / an audit trail) — otherwise anything that truncates `users` would
# republish an unauthenticated admin minter on the production hostname.
#
# This token is the ONLY way past that latch, and it exists because the opposite
# failure is just as bad: scripts/reset-super-admin-password.js only resets the
# password of an EXISTING super_admin row, so an owner with no Super Admin account
# at all has no scripted way back in. Setting an env
# var needs shell access to the box, which is the same authority such a script
# would have required.
#
# Leave it unset in normal operation. Set it, restart, recover the account,
# then unset it and restart again. Never commit a real value.
#
# MINIMUM 24 CHARACTERS — anything shorter is ignored (with a startup warning),
# because the comparison is length-first and a short token is both guessable and
# length-leaking. Generate with: openssl rand -hex 32
# SETUP_RECOVERY_TOKEN=

# --- Named logins (each off unless set to exactly "true"; what they do is noted
# beside POST /api/auth/login in server.js) ---
# SIGN_IN_AUDIT_ENABLED=
# NAMED_LOGINS_ENABLED=

# --- KPI Viewer role (off unless set to exactly "true") ---
# The role enters the users table's CHECK only through
# scripts/migrate-users-kpi-viewer-role.js: a read-only dry run by default, and
# its --apply (app stopped, backup taken) is refused while this is off. With it
# on, each start checks that the CHECK admits the role and logs one error
# naming the script when it doesn't. Off: no check at start.
# KPI_VIEWER_ENABLED=

# --- Parallel-dev port overrides (per-worktree, optional) ---
# When running multiple worktrees side-by-side, give each its own ports.
# VITE_DEV_PORT is the Vite dev server port; VITE_API_TARGET is the Express
# backend that Vite proxies /api, /socket.io and /uploads to. Leave both unset for the
# default 5173 → http://localhost:3000 pairing.
# VITE_DEV_PORT=5173
# VITE_API_TARGET=http://localhost:3000

# --- Google Sheets / Drive / Maps ---
# Spreadsheet IDs. SPREADSHEET_ID is required: without it the server refuses to
# start (lib/sheet-id.js). Only production's own pm2 process (logistics-app in
# /var/www/logistics-app) leaves it unset and gets the production sheet. Point
# staging, local and test runs at a separate copy. ARCHIVE_SPREADSHEET_ID left
# unset reads production's read-only archive. The service account
# (sheets-bot@logistics-app-491014.iam.gserviceaccount.com) must be shared on
# whichever sheet you point at.
SPREADSHEET_ID=
ARCHIVE_SPREADSHEET_ID=
# LEGACY — read by server.js but currently unused: POD/document uploads are
# written to local uploads/ and never to Drive (Drive is used only for
# rate-cons, below). Leaving it empty changes nothing.
GOOGLE_DRIVE_FOLDER_ID=
# Drive folder the n8n email pipeline files every rate-con into, named by email
# subject. getRateConBytes() searches it (by file name, then by content — see
# "Rate-con lookup BY CONTENT" below) to attach the rate-con to a drafted
# invoice; POST /api/admin/ratecon-index scans it; POST /api/loads/from-ratecon
# mirrors a dropped PDF into it, best-effort. No default: production's .env
# names production's folder, and no other server ever names it. A staging or
# local server names a folder of its own, or leaves this unset: unset (or
# blank), the rate-con Drive features are off and nothing calls Drive. Invoice
# drafting finds only the local rate-con archive, POST /api/admin/ratecon-index
# answers 503, a dropped PDF is archived locally only, and the server logs one
# warning at start naming this setting. scripts/repair-job-tracking-addresses.js
# refuses to run without it.
RATECON_DRIVE_FOLDER_ID=
# The SERVER key. Used for every outbound Google call the app makes itself:
# Geocoding, Distance Matrix, Routes, and Places (New) searchNearby/searchText
# — i.e. the dashboard maps' route directions, geocoding, and the diesel
# truck-stop POI layer on the tracking map (GET /api/poi/fuel-stops).
# Restrict this one by IP ADDRESS (the VPS) in the Google Cloud console.
# It must never be sent to a browser.
GOOGLE_MAPS_API_KEY=
# The BROWSER key — the only value GET /api/config/maps-key hands out, and the
# one the Maps JavaScript API + Places Autocomplete run on. That endpoint is
# unauthenticated by necessity (the public /apply, /invest and /track/:loadId
# pages load a map before any session exists), so treat this key as PUBLISHED:
# anyone can read it with one curl. Restrict it by HTTP REFERRER to the app's
# own hosts and by API to Maps JavaScript + Places.
#
# Optional. Unset falls back to GOOGLE_MAPS_API_KEY, which is the pre-split
# behaviour — and that single shared key CANNOT be restricted at all, because
# a referrer restriction breaks every server call and an IP restriction breaks
# every map. Two keys is what makes any restriction possible.
# Set means a non-blank value that does not contain GOOGLE_MAPS_API_KEY
# (surrounding whitespace ignored); a blank value or one holding the server key
# counts as unset. Once it is set, no response carries the server key. While
# it is unset, the server logs one "[maps]" warning at each start (never per
# request) and GET /api/admin/maps-key-usage reports browserKeyDistinct: false.
GOOGLE_MAPS_BROWSER_KEY=
# US dollars per 1,000 Dynamic Maps loads — the list price GET
# /api/admin/maps-key-usage multiplies the browser-key handout counter by (one
# handout per GET /api/config/maps-key) to ESTIMATE browser-side Maps spend.
# Pricing only: it changes no behaviour and caps nothing — the Google console
# stays authoritative. Default 7.
MAPS_DYNAMIC_LOAD_USD_PER_1K=7

# --- Google API transport (dead keep-alive sockets) -------------------------
# Both optional; the defaults are the shipped values and are what you want.
# Added after the 2026-08-06 dashboard outage, where a request handed to a
# half-open pooled socket blocked ~150s (a TCP retransmission budget) while
# Google itself answered the same read in ~470ms. See the long note beside
# google.options() in server.js before changing either.
#
# Per-request ceiling on EVERY Sheets/Drive call, and on the OAuth token
# exchange. node-fetch applies it twice and independently — once until response
# headers, once over the body read — so a large slow read is not charged for the
# server's think time. A timed-out request is retried on a fresh socket (GET/PUT
# only; never POST, which would duplicate a values.append).
GOOGLE_API_TIMEOUT_MS=15000
# Idle timeout on FREE (pooled) sockets only — in-flight requests are never
# affected. 5000 matches Node >=19's own https.globalAgent default; do NOT raise
# it, that widens the window in which a stale socket can be drawn.
GOOGLE_SOCKET_IDLE_MS=5000

# --- Long values in documents (lib/policy-renderer.js) ----------------------
# POLICY_FIELD_WRAP_ENABLED: DEFAULT OFF; only exactly "true" turns it on.
# A document's blanks are text inputs, and an input prints one line and only
# what fits its box: a long signer's name pushed the date off the substance
# policy's "Driver signature and date" line, and the render still passed. On,
# a value wider than its box prints wrapped, in a box of the same width, font
# and underline, in every document the renderer makes (onboarding, investor
# and invoice); a value that fits prints exactly as before. A required field
# that still doesn't fit refuses the render, as a field never filled is
# refused (DOCUMENT_FIELDS_UNFILLED): the driver is told to wait to hear from
# staff rather than to try again, and the failure is stored, alerted and shown to
# Super Admins under Data issues ("Onboarding documents that failed to
# render") naming the document and the field, never its value. Off, every
# render is what it was before this setting. Signed copies already stored are
# never re-rendered either way. Read at each render from the environment the
# app started with, so a change takes effect when the app restarts.
POLICY_FIELD_WRAP_ENABLED=false

# --- PDF rendering (lib/pdf-browser.js — one shared Chromium) ---------------
# All optional; the defaults are the shipped values. Every HTML→PDF render —
# onboarding and investor documents, invoice and statement PDFs, previews, the
# Friday invoice batch — goes through one Puppeteer browser. Plain numbers only:
# these are not validated, and a non-numeric PDF_MAX_INFLIGHT becomes NaN, which
# refuses every render as busy.
#
# Pages open at once across that browser: the global gate. It counts OPEN PAGES,
# not calls. The per-route preview caps in server.js are separate on purpose.
# Clamped 1-8. Default 3.
PDF_MAX_INFLIGHT=3
# How long a render waits for a free page before it is refused with
# PDF_RENDERER_BUSY — brief by design, never an unbounded queue (the public
# investor application renders three documents inside one 20 s client budget).
# Clamped 0-15000 ms; 0 refuses at once when the gate is full. Default 3000.
PDF_QUEUE_WAIT_MS=3000
# Puppeteer setContent timeout per render, ms. Not clamped. A timeout is retried
# once, and only when the event loop was measurably blocked. Default 30000.
PDF_NAV_TIMEOUT_MS=30000
# At shutdown, how long browser.close() gets before Chromium is SIGKILLed —
# close() alone was leaving orphaned Chromium processes behind. Clamped
# 250-10000 ms. Keep it below pm2's kill_timeout (5000 in ecosystem.config.js),
# or pm2's own SIGKILL lands first and the browser is orphaned again. Default 3000.
PDF_CLOSE_TIMEOUT_MS=3000

# --- Documents read from a folder (lib/policy-template-folders.js) -----------
# Three onboarding documents, the contractor agreement, the substance policy
# and the vehicle lease, can each be read from a folder on the server instead
# of the repo, named by its own setting below, so each server can hold its own
# copy. No default in code: each server names a folder of its own. A change
# takes effect when the app restarts.
# Unset or blank (the default), a document is read from the repo exactly as
# before, and the apply page's substance policy PDF is the client build's copy.
# Set to the absolute path of a local folder (the server's own disk, not a
# network mount, since every render and every request for the PDF reads it),
# that document is read from the folder only, for every preview, signed copy
# and investor preview. A folder or file that is
# missing or can't be read, or a file that (links followed) lies outside the
# folder, refuses the render with one [policy-templates] log line naming the
# setting and the file; the repo's copy is never read in its place. While any
# of them is set, each start logs where each document is read from.
# Each folder holds its document under the repo's file name:
#   POLICY_TEMPLATE_DIR_CONTRACTOR_AGREEMENT  contractor-agreement.html
#   POLICY_TEMPLATE_DIR_SUBSTANCE_POLICY      substance-policy.html, and
#     LogisX-Substance-Policy.pdf, which the apply page's link
#     (/policies/LogisX-Substance-Policy.pdf, public as before) then serves in
#     place of the build's copy. Only that file is ever served from the folder;
#     if it can't be, the link answers 503, never the build's copy.
#   POLICY_TEMPLATE_DIR_VEHICLE_LEASE         vehicle-lease.html
# Keep the folders outside the app's own folder, so a code update never changes
# them. Before setting one: copy today's file(s) into its folder, render the
# document from the folder and compare it with today's render, then set it and
# read it back by name.
# POLICY_TEMPLATE_DIR_CONTRACTOR_AGREEMENT=
# POLICY_TEMPLATE_DIR_SUBSTANCE_POLICY=
# POLICY_TEMPLATE_DIR_VEHICLE_LEASE=

# --- Email (driver onboarding + investor outreach) ---
# The mailbox every email is sent from, and the Gmail drafts land in. Without
# both, nothing is sent. The operational alerts (weekly invoice runs, undated
# loads, submitted invoices, ingestion alerts) go to GMAIL_USER itself, so
# without it there is no alert email either.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The inbox the admin notifications go to: new driver and investor
# applications, driver and investor acceptances, signed driver documents, and
# the website's investor RFI form. No default in code: production's .env names
# production's inbox, and no other server ever names it, so a local or staging
# run can't mail it by accident. Unset (or blank), each of those emails is
# skipped and nothing else in its request changes, the RFI form answers "We
# couldn't send your request" (503 SEND_FAILED) and sends nothing, and the
# server logs one warning at start naming this setting. A test server names an
# inbox of its own (example.test, a reserved name nothing delivers to, as here).
ADMIN_NOTIFY_EMAIL=admin@example.test

# --- KPI bot ------------------------------------------------------------------
# The nightly KPI snapshot behind /admin/kpis and the weekly KPI digest email.
# ⚠️ BOTH FLAGS DEFAULT **ON**. READ THE SHAPE, NOT THE NAME: they are the
# `!/^(false|0|no|off)$/i` form, so setting either to true is a NO-OP; the only
# thing each can do is switch its part OFF (false/0/no/off, then restart the
# app). Neither writes a money figure: the job only reads the system and keeps
# aggregated figures (counts, totals, rates; never a driver, broker, shipper or
# customer name, a load ID or a file name) in its own kpi_* tables.
#
# KPI_SNAPSHOT_ENABLED: the nightly snapshot, every day at 04:00 APP_TIMEZONE
# (US Eastern). A missed slot is caught up later the same business day,
# starting 10 minutes after the app starts. The snapshot also
# reads up to 40 stored rate-con PDFs a night for load weights, from Google
# Drive only where RATECON_DRIVE_FOLDER_ID is set. Off: no snapshot and no KPI
# email is scheduled; the page keeps the last stored figures, and a Super
# Admin's recompute (POST /api/admin/kpis/recompute) still runs.
#
# KPI_WEEKLY_ENABLED (not one of the two default-on switches): weekly figures
# beside the monthly ones, default OFF, on only when exactly "true". Weeks run
# Saturday to Friday, as driver invoices do. On: each run also stores, per
# metric, the 13 complete weeks before its week and that week to date in
# kpi_series_weekly, and the Super Admin KPI page shows them; four metrics stay
# monthly only, with the reason shown. The first start with it on records the
# day weekly figures began (server_state 'kpi.weekly_since'). The digest does not
# change. Off: nothing weekly is computed, stored or shown, and every KPI answer
# is as before. Read once at start.
# KPI_WEEKLY_ENABLED=true
#
# KPI_DIGEST_ENABLED: the weekly digest, Mondays at 09:00 APP_TIMEZONE (US
# Eastern), to the recipients set on the KPI page, or to ADMIN_NOTIFY_EMAIL
# when the page names none; with neither, nothing is sent. A digest more than
# 6 hours late is recorded as missed and never sent late. Once, after the first
# successful snapshot, one PREVIEW digest goes to ADMIN_NOTIFY_EMAIL only
# (never the page's recipients), marked "PREVIEW – not approved for public
# use". Off: no KPI email at all, the preview included.
KPI_SNAPSHOT_ENABLED=true
KPI_DIGEST_ENABLED=true

# --- Automatic broker invoice drafts (lib/auto-invoice-job.js) ---------------
# Every 5 minutes a sweep of Job Tracking finds the loads that became Delivered
# and drafts each one's broker invoice into Gmail Drafts with the Draft Invoice
# button's own engine. Nothing is ever sent: a person checks each draft and
# sends it. Super Admin only. Read once at start; a replica runs no timer.
#
# AUTO_INVOICE_DRAFTS_ENABLED: on only when exactly "true" (spaces around it
# ignored; TRUE, 1, yes and on stay off). Off: no timer, no table and no route,
# so a GET under /api/auto-invoice/ reaches the app page and a write gets
# Express's own 404; /api/dashboard answers as before.
# AUTO_INVOICE_DRAFTS_SHADOW: with the flag on, shadow mode unless it is
# exactly "false". Shadow makes no Gmail drafts: it only records what it would
# draft, with no engine, invoice number, Drive, Gemini or Gmail call, so
# ENABLED=true alone can never make a draft. Its one other write: a settings
# problem stores and sends one in-app Super Admin notice. Real drafts need
# SHADOW exactly "false", plus GMAIL_USER and GMAIL_APP_PASSWORD (without them
# the job pauses and logs it once) and, for Bison loads, BISON_INVOICE_EMAIL
# (next section).
# AUTO_INVOICE_MAX_PER_HOUR (default 12, at most 1000) and
# AUTO_INVOICE_MAX_PER_DAY (default 60, at most 10000): a burst of deliveries
# drains over hours, not into Gmail at once. Anything but a whole number in
# range keeps the default.
# AUTO_INVOICE_DRAFTS_ENABLED=
# AUTO_INVOICE_DRAFTS_SHADOW=
# AUTO_INVOICE_MAX_PER_HOUR=
# AUTO_INVOICE_MAX_PER_DAY=
# The render shadow, for the shadow week's comparison: AUTO_INVOICE_SHADOW_RENDERS_ENABLED
# is on only when exactly "true", read only in shadow mode, and never in a replica.
# On, the shadow also builds each ready load's invoice email and PDF in memory,
# with the Draft Invoice button's engine (Drive, Gemini when needed and the PDF
# renderer, as a real draft does, within the caps above) and a placeholder
# invoice number, and keeps only a digest of them (hashes, the recipient and the
# attachment names) in auto_invoice_shadow. Still no invoice number, no Gmail
# draft and no draft row. Kept until the comparison's decision plus 30 days (45
# days at most); a refreshed copy has none. No renders on Friday evenings
# (Eastern), when the weekly invoice batch uses the renderer.
# AUTO_INVOICE_SHADOW_RENDERS_ENABLED=

# --- Broker invoice drafts (POST /api/loads/:loadId/draft-invoice) ---
# The broker AP inbox an invoice draft is addressed to. BISON_INVOICE_EMAIL is
# Bison Transport's AP inbox, for every Bison load whatever its rate-con says;
# DEFAULT_INVOICE_EMAIL bills every other broker whose rate-con names no
# "email documents to" address. No default in code: production's .env names
# the real inboxes, and no other server ever names them, so a local or staging
# draft is never addressed to a real broker by accident. Unset (or not an email
# address), a draft that needs one has an empty To and is refused (503
# INVOICE_RECIPIENT_UNCONFIGURED; no invoice number is used and nothing is
# created) unless the reviewer types the recipient. The ?dryRun=1 preview still
# opens, with an empty recipient, and the server logs one warning at start
# naming the missing setting.
BISON_INVOICE_EMAIL=bison-ap@example.test
DEFAULT_INVOICE_EMAIL=ap@example.test
# The payout bank's routing number and account number, printed in the
# invoice's "Payment Method" block. No default in code, read at each render:
# production's .env names them, and no other server does (staging and local
# leave them unset; replica:pull never copies them). Anywhere else, each unset
# (or blank) one prints "Bank details not set" in its slot, the draft is still
# made, and the server logs one [invoice-bank] warning at start naming it.
# INVOICE_BANK_ROUTING=
# INVOICE_BANK_ACCOUNT=

# --- Rate-con viewers and protected accounts ---------------------------------
# The account ids (users.id, comma-separated, plain digits: 1 or 1,7) that may
# open rate-con files inside the app: the load's rate-con viewer, the
# /uploads/rate-cons/ files and rate cons stored as load documents, and the
# rate-con tabs of the invoice review screen. Every other Super Admin gets 403
# RATECON_VIEW_RESTRICTED there; drafting an invoice still attaches the rate
# con. The same accounts are protected: only the account itself or another
# listed one can change its password, role, email or driver name, or remove it
# (403 PROTECTED_ACCOUNT, audited). Server environment only, so nobody changes
# it from the app; only production's .env names production's accounts.
# Unset (the line absent): the behaviour before the list existed, and one
# warning per start. Set but invalid (empty, a username, "01", a stray comma):
# nobody opens a rate con in the app and no Super Admin's password, role,
# email or driver name changes, with one error per start. Account ids only,
# never usernames.
# Create the account first, then list its id: ids are given out in order, so
# an id listed before its account exists goes to the next account created. At
# each start the server logs one error for every listed id that is not a
# Super Admin account.
# Recovery: if every listed account loses Super Admin (demoted or removed),
# nobody can open rate cons in the app or change those accounts:
# fix or unset the list and restart.
# RATECON_PDF_VIEWER_IDS=

# --- Gemini Vision (expense receipt OCR) ---
# Optional. When unset, the receipt-OCR endpoint returns 503 and the driver
# form silently falls back to manual entry.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash
# Model for the expense-intelligence AI features (POST /api/expenses/ai/query,
# GET /api/expenses/ai/insights), read at call time by getConfig() in
# lib/expense-ai.js. Empty (the default) follows GEMINI_OCR_MODEL, then
# gemini-2.5-flash — set it only to run those features on a different model
# than receipt OCR.
GEMINI_AI_MODEL=

# --- Routemate ELD/telematics integration ---
# Base URL is the production Routemate cloud. Override only for sandbox use.
ROUTEMATE_BASE_URL=https://cloud.routemate.ai
# Issued by Routemate. Sent as the X-Api-Key header on every request.
ROUTEMATE_API_KEY=
# Master kill switch. Leave false until the API key is wired and at least one
# truck is linked to a Routemate vehicle. When false, all sync intervals are
# dormant and the manual probe (POST /api/admin/routemate/sync-now) returns 503.
ROUTEMATE_ENABLED=false
# Polling cadences (used in Phase 2+; harmless when ROUTEMATE_ENABLED=false).
# ROUTEMATE_POLL_DAILY_HOUR is read by nothing today — kept for the daily rollups.
ROUTEMATE_POLL_LIVE_SEC=60
ROUTEMATE_POLL_FAULTS_SEC=300
ROUTEMATE_POLL_DAILY_HOUR=4

# --- Linxup GPS / telematics (webhook push) ---
# Linxup is the fleet GPS provider. Unlike the Routemate poller, Linxup PUSHES
# telemetry to us: it POSTs each message to /api/eld/linxup/webhook — we never
# poll Linxup, so there is no base URL or poll cadence here.
# Master write switch. Leave false until the token is set and a real push has
# been verified. When false the webhook still ALWAYS enforces the token gate, but
# pushed positions are recognized/counted only, never written to live tracking or
# driver pay — so the feature ships dormant (matches ROUTEMATE_ENABLED).
LINXUP_ENABLED=false
# Shared secret Linxup presents on every push. The receiver accepts it as
# Authorization: Bearer <token>, X-Api-Key, X-Webhook-Token, or X-Linxup-Token
# header, or a ?token= query param. Blank → the webhook returns 503 (not
# configured). Never commit a real value.
LINXUP_WEBHOOK_TOKEN=
# Unit of the `speed` field on pushed Position messages; converted to m/s on
# ingest (downstream/tracking + the driver-pay travel gate expect m/s).
# mph | kmh | mps (default mph — US provider). mph is CONFIRMED from live pushes
# (2026-07-25, re-verified 2026-09-19); judgeSpeedUnit() alarms if it ever changes.
LINXUP_SPEED_UNIT=mph

# --- ELD miles: the day a device link changes on (2026-10) --------------------
# The daily miles rollups (eld_miles_daily, eld_state_miles_daily) and the
# mileage routes put each day of a device's miles on the truck it was linked to
# that day (eld_device_assignments; on a re-point day the newer link wins). A
# link's start and end are stored as UTC instants, so a re-point from 8 PM EDT
# (7 PM EST) counts on the next day: that day stays on the older truck, an
# evening unlink keeps the device on its old truck one more day, and an evening
# first link leaves its day on no truck.
# On, each bound is read on its business day (APP_TIMEZONE), so an evening
# re-point behaves as a daytime one: the newer truck gets the whole day's miles,
# though the device drove most of them on the older one (each row's driver is
# still the one at each ping). A truck west of APP_TIMEZONE re-pointed in the
# last one to three hours of its own day (Central to Pacific) still counts on
# the next day. The mileage routes show every such day under the newer truck at
# once; the stored rows (KPI miles, Financials miles by state) change only for
# the days a rollup re-derives (its catch-up window, at least 3 days), so older
# days keep the older truck there. Display only: no payout, invoice, expense or
# driver-pay figure reads these tables.
# DEFAULT OFF. Enable with exactly "true".
ELD_APP_DAY_ENABLED=false

# --- ScanKit.io document scanning ---
# Powers the document scanner (driver POD/BOL, expense receipts, admin uploads)
# via POST /api/documents/scan — server-side only, never exposed to the client.
# Base URL is the production ScanKit API; override only for sandbox use.
SCANKIT_BASE_URL=https://api.scankit.io
# Issued by ScanKit (format sk_...). Sent as the Authorization: Bearer header.
SCANKIT_API_KEY=
# Master kill switch. Leave false until the API key is wired. When false (or the
# key is unset), POST /api/documents/scan returns 503 and the client scanner
# falls back to attaching the raw photo (receipts simply skip enhancement).
SCANKIT_ENABLED=false
# ScanKit is credit-billed: charged per successful scan (HTTP 2xx); 4xx errors
# like 402 are NOT billed and NOT retried. When credits run out the scan endpoint
# returns 402 and the driver app falls back to attaching the raw photo — the POD
# still uploads, just without crop/deskew/lighting enhancement. Setting
# SCANKIT_ENABLED=false fully disables scanning (endpoint returns 503 + the same
# raw-photo fallback). Recovery / credit top-up / key-rotation runbook:
# docs/runbooks/scankit-billing.md

# --- Automatic weekly invoice generation ---------------------------------
# Master kill switch for the Friday 7:00 PM batch on the business clock
# (APP_TIMEZONE, US Eastern unless set; DST-aware) —
# after the 6:30 PM driver cutoff; the two times are a pair —
# that generates AND auto-submits every driver's weekly invoice (drivers kept
# forgetting to submit). Approval stays manual — nothing is auto-approved/paid.
# DEFAULT OFF (this moves money): stays dormant until explicitly enabled here,
# matching ROUTEMATE_ENABLED / SCANKIT_ENABLED. Enable with true/1/yes/on.
# On first enable it seeds a baseline so it never retroactively bills a past
# week — the first real run is the next Friday. A boot catch-up covers a restart
# across 7 PM; a week with drivers who worked-but-weren't-billed retries (bounded)
# and emails GMAIL_USER and notifies dispatch with an ACTION-NEEDED summary.
INVOICE_AUTOGEN_ENABLED=false

# Completed loads that NO weekly invoice can bill: marked completed, but with no
# Status Update Date and no Completion Date. The batch above names one only when
# an appointment falls in its billing week; the rest (blank appointments, or a
# sheet edit weeks later) were billed by nobody and reported to nobody. After
# each Friday run this sends ONE digest (email + dispatch notification) of the
# new or re-opened ones, once per load (invoice_undated_alerts). A digest names
# at most 25 loads (a rolling 24 h cap, so in practice 25 per weekly run); the
# rest wait for the next run. The first run records every completed load of the
# day SILENTLY as history, and history never reports.
# ⚠️ DEFAULTS ON — a kill switch, not an enable switch (the !/^(false|0|no|off)$/i
# shape, like RATECON_EXTRACT_ALERT_ENABLED): "true" is a no-op, only
# false/0/no/off turns it off. It moves no money — it writes no invoice, marker
# or pay figure — and it runs only where INVOICE_AUTOGEN_ENABLED is on.
INVOICE_UNDATED_ALERT_ENABLED=true

# --- n8n -> app rate-con extraction + distance ----------------------------
# TWO endpoints accept EITHER N8N_WEBHOOK_SECRET or this extract-only secret:
#   POST /api/n8n/extract-pdf-via-gemini   (node "Extract via LogisX")
#   POST /api/n8n/load-distance            (node "Distance via LogisX")
# It exists because n8n Cloud cannot hand this workflow a usable credential
# through its API (create works, but read/list/projects are all 403 and an
# API-created credential isn't visible to the workflow owner), so the value must
# live in a node parameter — plaintext in the workflow JSON, readable by anyone
# with n8n access. Both nodes present the SAME value, so there is one thing to
# rotate.
#
# N8N_WEBHOOK_SECRET must NOT be used there: it also gates POST /api/n8n/job and
# POST /api/webhook/new-load, which CREATES LOADS. A leak of this scoped secret
# only burns Gemini credits and Distance Matrix elements on two rate-limited
# endpoints that write nothing — no sheet, no SQLite, no Drive.
#
# ⚠️ ROTATION IS A FOUR-STEP JOB AND THE ORDER MATTERS. The value now lives in
# three places, and a fourth that cannot be edited at all:
#   1. `Distance via LogisX` node parameter (n8n)
#   2. `Extract via LogisX` node parameter (n8n)
#   3. this variable in the VPS `.env`  ← change this LAST
#   4. n8n Cloud's `activeVersion` / `workflowPublishHistory` snapshot, readable
#      on GET /workflows/:id — deleting or editing a node does NOT revoke it.
# The server is what stops accepting the old value, and it stops the instant (3)
# changes — so doing (3) first 401s both nodes until the others catch up. Change
# the nodes first, the server last. Treat the history copy as permanently
# disclosed: rotation limits future use, it does not un-publish the old value.
# This is the same trap that made the deleted plaintext Google Maps key in
# `Get Distance Matrix` non-revocable by deletion.
#
# Interim, not permanent: once a Header Auth credential is created in the n8n UI,
# point both nodes at it and delete this.
N8N_EXTRACT_SECRET=

# The SHARED n8n secret, presented as the x-webhook-secret header. It is the
# only secret POST /api/n8n/job and POST /api/webhook/new-load accept, and the
# two endpoints above accept it alongside N8N_EXTRACT_SECRET. Empty (the
# default) → /api/n8n/job and /api/webhook/new-load answer 401 to every call
# (fail closed). Also sent on the invoice-draft fallback below. Never commit a
# real value.
N8N_WEBHOOK_SECRET=

# Fallback for POST /api/loads/:loadId/draft-invoice: when the IMAP draft
# (GMAIL_USER + GMAIL_APP_PASSWORD) is not configured or fails, the invoice
# packet is POSTed to this n8n webhook instead, carrying N8N_WEBHOOK_SECRET.
# Used only when BOTH are set; empty (the default) means no fallback.
N8N_INVOICE_WEBHOOK_URL=

# --- Rate-con reconciliation (ingestion backstop) -------------------------
# Answers, from OUTSIDE the pipeline: did every rate-con email actually become a
# load? On 2026-08-05 two loads reached the mailbox and never reached the sheet —
# one during a Gemini outage, one because an n8n Filter node discarded a bad
# extraction with NO alert while still reporting success. Both were found by hand.
# Alerting on n8n's reject branch makes KNOWN failures loud; this catches the ones
# nobody has thought of (execution never starts, Gmail filter stops matching, n8n
# outage, workflow left deactivated) because it only compares email vs sheet.
#
# READ-ONLY on the mailbox (IMAP EXAMINE + BODY.PEEK): it must never set \Seen or
# \Flagged — n8n's Gmail Trigger selects on unread+starred, so a sweep that marked
# mail read would silently stop ingestion, i.e. cause the outage it detects.
# Alerts ONCE per load id, because a daily repeat of the same gap trains everyone
# to ignore the channel. Runs every 6h; also on demand via
# GET /api/admin/ratecon-reconcile (?dryRun=true reports without alerting).
# DEFAULT OFF, matching the other side-effectful integrations.
RATECON_RECONCILE_ENABLED=false
# ⚠️ NOW A FLOOR, NOT THE WINDOW. It used to be the entire lookback (capped at
# 60 days), which meant a gap older than it was not "harder to find" but
# structurally unreachable — and a sweep outage silently threw away the days
# nobody swept, because 14 days is always measured from *now*. That is how load
# 556354570 (16 Jun 2026) went eight weeks undetected. The window is now a
# HIGH-WATER MARK: each sweep reads everything since the last successful one,
# never less than this, never more than RATECON_RECONCILE_MAX_DAYS.
RATECON_RECONCILE_DAYS=14
RATECON_RECONCILE_MAX_DAYS=400
# Periodic full re-read, so anything the incremental chain dropped cannot stay
# dropped. The FIRST deep sweep is treated as a baseline: measured on production
# it finds 63 historical gaps against 0 in the 14-day window, so it is reported
# once as a labelled review list rather than as 63 fresh failures. Every load is
# still alerted exactly once, ever (ratecon_reconcile_alerts).
RATECON_RECONCILE_DEEP_DAYS=365
RATECON_RECONCILE_DEEP_EVERY_HOURS=168
# Where a load number may be read from. STAGED — subject, then the PDF
# attachment name, then the body, each only where the previous stage found
# nothing — so these can only ever see messages the subject scan left silent
# (12 of 687 on the real label) and cannot add a false positive to the rest.
# Measured on all 745 messages: the two stages add ONE candidate and the staging
# refuses one phantom (Trident names the real load in its subject but its
# attachment is an internal doc number). Set either to false to narrow back.
RATECON_RECONCILE_SCAN_FILENAMES=true
RATECON_RECONCILE_SCAN_BODY=true
RATECON_RECONCILE_MAILBOX=RATECONs

# --- Rate-con lookup BY CONTENT ---------------------------------------------
# getRateConBytes() finds an emailed rate-con by matching our Load ID against the
# Drive FILE NAME, which is the raw email subject. That only works when the
# subject happens to carry our number: measured 2026-08-19, 50 of 421 loads have
# no file-name match (load 30080873 is filed as "Bison Transport Order #7101850").
# When the name misses, the route reads the PDFs instead and looks for the load id
# INSIDE them, then caches the hit as a documents row so it never rescans.
#
# These three are COST controls on Drive downloads, not correctness knobs —
# widening them scans more PDFs, it does not make a match more likely to be
# right (lib/ratecon-drive-index.js decides that, and refuses anything without an
# independent corroborating signal).
RATECON_CONTENT_WINDOW_DAYS=21
RATECON_CONTENT_MAX_FILES=40
# Overlapping reads. A SEQUENTIAL 40-file scan measured 137 s — round trips, not
# bytes (the whole window is 2.6 MB) — against a client that gives up at 60 s.
RATECON_CONTENT_CONCURRENCY=6
# Ships dormant, like every other consequential writer. The PROPOSAL run works
# with this off — POST /api/admin/ratecon-index reports what it would link, with
# the reasons — so a run can be read in production before anything is written.
RATECON_INDEX_APPLY_ENABLED=false

# --- same-site CSRF: the X-Requested-With requirement --------------------------
# ⚠️ A KILL SWITCH, NOT AN ENABLE SWITCH — it defaults ON and only an explicit
# "false" disables it (same posture as PII_MASK_ENABLED). requireAuth and
# requireRole refuse a state-changing request that does not carry
# X-Requested-With, which closes the gap crossSiteGuard cannot: refuseCrossSite
# tolerates Sec-Fetch-Site: same-site, so a page on a SIBLING logisx.com host
# (logisx.com is a Wix site, governed by a credential that lives nowhere in this
# repo) otherwise reached every guarded route with a live session cookie.
#
# It was added for the legacy public/ pages, whose raw fetch sent no header.
# Those pages are gone (without client/dist every page is the 503 "being
# updated" page), and the SPA's requests carry the header (useApi.js). The
# switch stays as a kill switch; leave it on.
CSRF_HEADER_REQUIRED=true

# --- Unusable-address alerting (the OTHER silent ingestion loss) -----------
# RATECON_RECONCILE_* answers "did the email become a load?". It cannot answer
# "is the load it became usable?", and on 2026-08-09 six email-ingested loads
# were found that had passed every gate carrying an address nothing could place —
# and therefore $0.00/mi. The clearest is 550303758 ($740, delivered April 2026),
# whose Job Tracking `Drop-off Address` cell is still EMPTY while `Drop-off Info`
# reads "SAMS CLUB 8244".
#
# n8n could not have caught it: its order is Validate Load ID -> JOB DETAILS
# ENTRY (which WRITES the Job Tracking row) -> Addresses Ready?, so the row is
# created before any address is examined, and `Addresses Ready?` only gates the
# distance branch. A guard downstream of the write cannot stop a bad write. The
# check therefore lives in POST /api/n8n/extract-pdf-via-gemini, which sees the
# fields before any sheet does.
#
# ⚠️ DEFAULTS ON, deliberately breaking the ships-dormant convention — same call
# as PII_MASK_ENABLED and for the same reason: this is a KILL SWITCH, not an
# enable switch. A defect detector that ships off is a defect detector that stays
# off, and the failure it exists to break is silence. Set to "false" only to
# quiet it deliberately. It never blocks an ingestion: a load with one bad field
# still reaches the sheet, because a load with a gap beats no load at all.
# One email + one dispatch notification per NEW bad load id (ratecon_extract_alerts);
# with no GMAIL_* configured it degrades to the notification and a console line.
RATECON_EXTRACT_ALERT_ENABLED=true
# Global ceiling on alerts per rolling 24 h, keyed on nothing the caller controls.
# ⚠️ The once-per-load dedupe is the PRIMARY control, but its key is Gemini's
# reading of the caller's PDF — and the n8n secret sits in plaintext in a node
# parameter — so a caller who can post PDFs can mint fresh keys by incrementing a
# load number. This cap is the control that still holds when that one doesn't.
# It matters because sendEmail is SHARED with onboarding, investor outreach and
# the invoice batch: exhausting Gmail's daily quota here would take ALL outbound
# app mail down, i.e. the abuse would silence the very channel this feature needs.
# Production produced 6 bad loads in 151, so 25/day is far above any real rate.
RATECON_EXTRACT_ALERT_MAX_PER_DAY=25
# Re-issued rate cons (2026-10-13). For a load already in Job Tracking that is
# delivered or has an invoice draft (or when Job Tracking has no Job Status column
# to read), POST /api/n8n/keep-stored-values hands n8n the STORED Payment, Pickup
# Appointment and Drop-off Appointment, each found by header pattern (a blank
# stored date is not filled), and every column for a load in a closed month or one
# the email's dates would put in a closed month (or carry a date it can't place);
# what the email changed, old and new, is mailed to ADMIN_NOTIFY_EMAIL and posted as
# a dispatch notification (broker contact values left out of it), once per load,
# field and value (ratecon_reissue_holds), for a person to decide. A failed email
# or notification is retried on that channel only, by a sweep every 15 min (and on
# any later sighting of the same change), backing off: 15 min after the first try,
# then 30 min, 1 h, 2 h, then every 4 h (about 15 tries), for 48 h after the change
# was first seen; then it is given up, with one log line per load. Each sweep logs
# one line naming the loads still failing. A replica runs no sweep.
# ⚠️ DEFAULTS ON — a kill switch (the !/^(false|0|no|off)$/i shape): "true" is a
# no-op. It moves no money; it only keeps stored values.
RATECON_REISSUE_HOLD_ENABLED=true
# Ceiling on loads EMAILED per rolling 24 h for those alerts; sendEmail is shared.
# A load already emailed in the window, or still owed an email from an earlier
# alert however old (its retry), isn't held back; the loads still owed an email
# from an alert in the window count. Past it a new load's change gets the dispatch notification
# only, once, and is never emailed later, even after the window frees up; so is a
# change seen while ADMIN_NOTIFY_EMAIL is unset.
RATECON_REISSUE_ALERT_MAX_PER_DAY=25
# A date a person corrected (2026-10-22). On an OPEN load (one the re-issue hold
# above isn't protecting), a Pickup or Drop-off Appointment a person set (in the
# Google Sheet, or saved through LogisX) is never replaced by a later rate-con
# email: keep-stored-values hands n8n the person's date, and the change goes to
# ADMIN_NOTIFY_EMAIL and the dispatch notifications ("corrected date kept"), once
# per load, field and value, sharing the re-issue ledger, retry sweep and daily
# cap. "A person set it" = the stored date matches none of the dates the app
# itself wrote, or is the newest date a person saved in LogisX; the app records
# both in load_cell_writes FROM DEPLOY, whatever this flag says, so the rule can
# tell. Off, the email's date is written as today and a "would hold" row is
# recorded instead: scripts/person-edit-hold-report.js --since=<date> lists them
# (read-only), and the flag goes on only after that shadow report is clean (no
# "format" rows, no rows to review). A date form the app can't read is never
# held, and the flag only ever adds holds: an email date the re-issue hold keeps out
# (a "TBD", a closed-month date) still holds every column. It holds nothing while
# RATECON_REISSUE_HOLD_ENABLED is off (one warning per start). Payment is not held
# by this rule.
# ⚠️ DEFAULTS OFF (the /^(true|1|yes|on)$/i shape). It changes no pay calculation,
# but pay reads the date it keeps.
RATECON_PERSON_EDIT_HOLD_ENABLED=false
# "Needs Confirmation" pickups (Arvin, 2026-10-21): when a rate con marks the pickup
# date "Needs Confirmation" (C.H. Robinson's shipper line, in the PDF's own text or
# Gemini's pickup notes), the load gets a Needs Review reason on the dashboard
# instead of the date being treated as firm, until a person corrects the Pickup
# Appointment, marks it confirmed (POST /api/loads/pickup-confirmed, Super Admin and
# Dispatcher, audited), or the driver's first pickup tap lands on that day. A load
# whose dates touch a closed month gets a fixed badge and no button. Display only:
# nothing that pays reads it, and the app never rewrites the date.
# ⚠️ DEFAULTS OFF (the /^(true|1|yes|on)$/i shape). Off: no reading kept, no record
# written, no `_review` codes, no modal line, and the confirm route answers 404.
RATECON_PICKUP_CONFIRMATION_REVIEW_ENABLED=false
# Ceiling on the SECOND Gemini pass (the retry that recovers a missed address).
# ⚠️ pdfOcrLimiter caps REQUESTS per IP; it is not a spend cap. Whether the retry
# fires is decided by the CONTENT of the caller's PDF, so a rate con with no rate
# makes it fire every time — a deterministic 2x amplifier on a GEMINI_API_KEY that
# is shared across Alchemy projects and has already been exhausted once
# (2026-08-05), taking ingestion down. Per rolling 15 min, across all callers.
# Exceeding it is NOT an error: the first-pass fields still ship.
RATECON_RETRY_MAX_PER_WINDOW=20

# --- Monthly settlement close (investor payouts) --------------------------
# Master kill switch for the month-end close: a work month stays open for
# straggler receipts for `settlement_grace_days` (investor_config, default 7)
# after it ends, then finalizes automatically — freezing the payout figure and
# publishing the statement. Late receipts land in the prior month by themselves
# during the window instead of needing a hand-written adjustment; a receipt that
# misses it posts to the current open month and the closed month never moves.
# DEFAULT OFF (this freezes money figures and publishes documents): with it off,
# every guard is inert and the payout ledger behaves exactly as before.
# Enable with true/1/yes/on.
# On first enable it seeds a baseline lock over every period whose window has
# already passed, so nothing is retroactively re-opened and no month that is
# still legitimately inside its window gets closed early.
# Blocks "Mark Paid" until a period is finalized (that block is what ends the
# correction treadmill); reopening a settled payout stays exempt.
PERIOD_FINALIZE_ENABLED=false

# --- Month-end guards: a truck assignment's start on the business day (2026-10) -
# The month-end guards refuse a write that would reprice a closed month: a truck's
# rate or owner change (judged against the driver it leaves on the truck; a driver
# change on its own isn't guarded), a truck delete, and the truck create,
# directory, investor and user edits. For a driver they guard the closed months
# from the earliest month the driver has a record in, and a truck assignment's
# start is one of those records (driverPayLockedMonths(),
# driverHistoryFloorMonth()). That start is stored as a UTC instant, so from
# 8 PM EDT (7 PM EST) it already reads as the next day, and on a month's last day
# as the next month: when it is the earliest record, an evening start on the 31st
# leaves that month unguarded.
# On, a start's month is the earlier of its UTC month and its month on the
# business clock (APP_TIMEZONE), so every guard refuses the same closed months or
# more, never fewer. Only the exact toISOString() shape is read on the business
# clock; any other text keeps its first seven characters, as before. It computes
# no figure and writes nothing but the audited refusal: a guard only refuses.
# DEFAULT OFF. Enable with exactly "true". Before switching it on, run a
# read-only report on production data: each driver whose floor month moves, and
# the closed months that join that driver's guard.
APP_DAY_STAMPS_ENABLED=false

# --- Investor payout basis: fixed monthly lease payouts ----------------------
# An investor's contract can pay a share of monthly net profit (the Split %) or a
# fixed monthly lease. The basis is recorded per investor in
# investor_payout_basis (from the signed master agreement at acceptance, or by a
# Super Admin), and this flag decides whether payouts follow it.
# DEFAULT OFF (it moves money): with it off the payout math ignores the basis
# table entirely and every payout, portal and statement figure is exactly what
# it was; acceptance still records the basis and admins can still see and edit
# it, so it can be checked before it pays anything. Enable with true/1/yes/on.
# On, a lease month pays the lease (whole dollars), carries no loss either way,
# and leaves split investors untouched. A settled month's basis never changes:
# a change can only start after the latest paid, processing or finalized month
# and after the latest closed month, and a month finalized as the split while
# the flag was off stays the split once it is on. A month finalized as a lease
# stays exactly the lease it settled at (its figures and its wording), whatever
# this flag, the three settings below or a truck's status or dates say later.
INVESTOR_LEASE_PAYOUTS_ENABLED=false
# How a lease month pays, read once at boot. A value that names no setting falls
# back to its default with one warning in the log; unset takes the default.
# Switching one moves only the months not yet finalized; a closed month keeps
# what it settled at. The defaults follow the contracts:
#   INVESTOR_LEASE_DOWNTIME   unpaid | paid     default unpaid: master agreement
#     §3.1, nothing is owed during Operational Downtime. "unpaid" pays $0 for a
#     month with no activity at all (no revenue, driver pay, trip expenses,
#     maintenance or compliance cost, no driver day: the same idle rule that
#     defers a month's fixed costs); "paid" pays the lease anyway.
#   INVESTOR_LEASE_PRORATE    daily | none      default daily: the lease term
#     starts at vehicle delivery (lease §1.02) and master §4.03 pays up to the
#     decommission date, so a month is paid for the days a truck was in service
#     (in_service_date, else the day it was added, through retired_at);
#     "none" pays the full lease for any month with a day in service. A truck
#     in Maintenance or OOS is still in service (the downtime setting decides
#     an idle month); only an Inactive truck is out of the fleet. The status is
#     read as it is now, so a change moves only months not yet finalized.
#   INVESTOR_LEASE_RETIREMENT stop | continue  default stop: master §4.03 / lease
#     §9.01, the lease ends with the truck (retired_at, inclusive); "continue"
#     ignores retirement.
# INVESTOR_LEASE_DOWNTIME=unpaid
# INVESTOR_LEASE_PRORATE=daily
# INVESTOR_LEASE_RETIREMENT=stop

# --- Payout rules (2026-10) --------------------------------------------------
# Four payout rules, switched together (payoutRules() in server.js):
#   - a blank-Owner-ID load belongs to the owner of the truck its driver held on
#     the load's date (truck_assignments), not to the investor the driver is
#     paired with today;
#   - each day of driver pay is priced at the rate in effect that day
#     (pay_rate_history, recorded when a rate is saved);
#   - a receipt dated after the day it was submitted counts in the month it was
#     submitted; a month's close books each such receipt to it;
#   - the loss carried into an open month reads each closed month at what it
#     settled.
# DEFAULT OFF (it moves money). Before enabling, review the dry run (GET
# /api/admin/payout-rules/dry-run, Super Admin): every open-month payout that
# would change, by how much and by which rule, and each load that would move
# between owners. Closed months never change. Enable with true/1/yes/on.
PAYOUT_RULES_V2_ENABLED=false

# --- Pre-dispatch pay days (2026-10) -----------------------------------------
# A drop-trailer rate con can carry a pickup date that is only the window for
# dropping an empty trailer (Drop Date/Time) or an unconfirmed "Scheduled
# Pick-up Date, Needs Confirmation" note. Ingestion copies it into Pickup
# Appointment, so the load's pay window opens on a day before the load was
# dispatched, and any ELD movement that day (a short local move) pays a
# driver day for it.
# On, a day stops paying FOR THAT LOAD when all of these hold
# (lib/load-pay-days.js):
#   - the day pays in PRE_DISPATCH_PAY_DAY_RULE_FROM or a later month (a day
#     pays in the load's Assigned month, or in its own month when the load
#     has none);
#   - it is before the load's dispatch day (its earliest Dispatched status
#     row), read in the truck's own time zone that day, and that dispatch is
#     no later than the load's last window day;
#   - the truck's ELD distance that day (odometer, from the last reading
#     before the day to the first one after it) is known and under 50 km;
#   - the truck had not yet loaded: no ELD fix within the geofence radius of
#     the load's pickup (load_coordinates) on any day of the load's window up
#     to and including that day (a rest day after loading keeps paying).
# Anything unknown keeps the day: no Dispatched row, a dispatch recorded
# after the window, no pickup coordinates, an ELD gap (fewer than two
# odometer readings that day, a jump the odometer walk rejects, no reading
# before or after the day). A day another load also covers keeps paying
# through that load. The weekly invoice, the investor view and the payout
# ledger (payouts and Financials) share the one rule, so they move together.
# DEFAULT OFF (it moves money). Enable with true/1/yes/on.
PRE_DISPATCH_PAY_DAY_RULE_ENABLED=false
# The first month the rule applies to, YYYY-MM (e.g. 2026-11). Required: with
# the flag on and no month here, the rule stays off and each start logs one
# warning. Whether a day follows the rule depends only on this and the month
# the day pays in, never on whether a month is open or closed, so a day pays
# the same before and after its month closes or reopens.
# It must be a month that has not closed. Closed months stay as recorded: a
# closed month's frozen payouts and Financials never move, but the investor
# view, the payout drill-down and statement appendix, and (while
# PAYOUT_RULES_V2_ENABLED is off) the loss carried into open months recompute
# closed months live, and a month at or before a closed one would change
# them. Best set to the month the flag is switched on in, on its first day,
# or to the next month: weekly invoices already issued in the month keep the
# days the rule would drop. Never change it once the rule has run. Once its
# month has closed with the rule on, each start logs one notice saying so
# (expected; the rule keeps running).
# PRE_DISPATCH_PAY_DAY_RULE_FROM=

# --- Ledger day-once (2026-10) ------------------------------------------------
# The payout ledger (payouts and Financials) and the investor view put each paid
# driver-day in its load's Assigned month, so a day that two loads with
# different Assigned months both pay is counted in both months. On, a day an
# earlier month already pays is dropped from every later month that is
# LEDGER_DAY_ONCE_FROM or later: the earliest month keeps it
# (lib/ledger-day-once.js). "Pays" means the days left after the ELD check, the
# pre-dispatch rule and remove overrides, plus admin-added days. Months before
# FROM are computed as before. The weekly invoice is not affected.
# DEFAULT OFF (it moves money). Enable with exactly "true". Before switching it
# on, review scripts/ledger-day-once-dry-run.js --from=<FROM> on the server.
LEDGER_DAY_ONCE_ENABLED=false
# The first month the rule applies to, YYYY-MM (e.g. 2026-10). Required: with
# the flag on and no month here, the rule stays off and each start logs one
# warning. It must be a month that has not closed (the dry run refuses one
# that has), for the same reason as PRE_DISPATCH_PAY_DAY_RULE_FROM above. Never
# change it once the rule has run; once its month has closed with the rule on,
# each start logs one notice saying so (expected; the rule keeps running).
# Never switch LEDGER_DAY_ONCE_ENABLED off again once FROM's month has closed:
# that would move those closed months' live figures (the investor view, the
# payout drill-down and statement appendix) and, while PAYOUT_RULES_V2_ENABLED
# is off, the loss carried into open months. Their frozen payouts stay as
# settled either way. While the rule is on, the daily integrity check reports
# any driver-day it decides against a closed month's settled record.
# LEDGER_DAY_ONCE_FROM=

# --- Trip work days (B12, 2026-10) --------------------------------------------
# The owner's rule for daily-rate drivers (decision d, 2026-10-21): a load pays
# the days the driver drives, loads or unloads on the trip, from the day he heads
# to the pickup through the day he unloads, read from his trip taps
# (load_status_history) and the truck's ELD, every day in US Eastern; days he
# only waits are not paid. With no taps: the appointment days plus the days the
# ELD shows driving (lib/trip-work-days.js). It replaces the appointment window
# cut by the ELD. A load whose taps or ELD cannot be read pays as before, named
# in the invoice warnings and the dry run. It
# applies on the weekly invoice, the investor view and the payout ledger alike,
# to loads settling (Assigned month) in TRIP_WORK_DAYS_FROM or later; months
# before FROM, closed months, frozen items and payouts never change. Each day is
# priced at the rate in effect that day. With it on, the ledger day-once rule
# above also applies from this FROM. A day found after its week's invoice was
# generated goes on that week's own invoice while it is not approved, else on a
# correction invoice (Draft) for that week, never on a later week's invoice.
# DEFAULT OFF (it moves money). Enable with true/1/yes/on. Before switching it
# on: review scripts/work-days-dry-run.js --from=<FROM> on the server, then run
# scripts/backfill-invoice-paid-days.js (--dry-run first); each start with the
# rule on repeats that backfill.
TRIP_WORK_DAYS_ENABLED=false
# The first settle month the rule applies to, YYYY-MM. Required: with the flag
# on and no month here, the rule stays off and each start logs one warning. It
# must be an open month (the dry run refuses a closed one). Late days start at
# its first week, so that month's invoices made before the switch-on are
# brought to the rule too (updated in place, or a correction Draft once
# approved). Never change it once the rule has run.
# TRIP_WORK_DAYS_FROM=

# --- Personal receipts (2026-10) ---------------------------------------------
# A Super Admin can mark all or part of a driver's receipt Personal: the
# purchase was the driver's, not the company's. The driver repays it on the
# weekly invoice of the week it is marked in ("Personal expense, <merchant>,
# <receipt date>: -$X"), or on that week's correction invoice once the weekly
# one is approved; never on another week's. The personal part then leaves
# every company figure (payout ledger, Financials, investor portal, tax and
# report totals, percentage pay, fuel spend and gallons, KPI). A receipt in a
# finalized month keeps its month as recorded; the credit books to the open
# month. An owner-operator's Personal part comes out of his percentage base
# and is deducted once in full.
# Off, NEW marks are refused (403 PERSONAL_DISABLED); undo, reverse, invoice
# generation, attaching lines and the weekly sweep keep working on lines that
# exist, so switching it off never strands a deduction already on an invoice.
# Before switching it on: run scripts/personal-expenses-dry-run.js (every
# figure equal to the cent with no mark; what chosen marks would change).
# DEFAULT OFF (it moves money). Enable with exactly "true".
PERSONAL_EXPENSE_DEDUCTIONS_ENABLED=false

# The receipt's week. On, a Personal line belongs to the week of its receipt
# date, not the week it is marked in (a receipt with no readable date, or one
# dated after today, takes the week it is marked in). While that week's weekly
# invoice is not generated yet, or is Draft, Submitted or Rejected in an open
# month with room, the line goes on it. Otherwise (Approved, Processing or
# Paid, a finalized month, no room) it is carried: it goes on the driver's
# oldest open weekly invoice after its week, in an open month, with room, or on
# the next one generated, printed with its receipt date. Oldest line first,
# never below $0, never split. No correction invoice is made (POST
# /api/invoices/personal-corrections answers 410 PERSONAL_CORRECTIONS_RETIRED)
# and the weekly sweep sends no notice. A line on an approved invoice is final:
# no Undo, no Reverse (409 PERSONAL_LOCKED). Lines already waiting at the
# switch-on keep the week they were marked in.
# Off, the rule in the block above applies (the week it is marked in, and a
# correction invoice once that week's invoice is approved), and carried lines
# read as flagged for a correction. New marks still need
# PERSONAL_EXPENSE_DEDUCTIONS_ENABLED on.
# Before switching it on: scripts/data-fix-personal-corrections.js --report
# (read-only; counts and amounts, no names) on production data. Once it is on,
# the same script's --dry-run and then --apply move the open Personal
# correction invoices' lines back to the carried queue.
# DEFAULT OFF (it moves money). Enable with exactly "true".
PERSONAL_RECEIPT_WEEK_ENABLED=false

# PDF receipts on the weekly invoice (R3 v2). With this AND the flag above on,
# a Personal line whose receipt is a PDF gets the receipt's own pages after its
# sheet (at most 6 pages a receipt, 15 an invoice), copied by a locked-down
# child process with no links, actions, forms, attached files or location data;
# anything it can't copy keeps "PDF receipt on file". Off, every PDF receipt
# keeps "PDF receipt on file" and the invoice prints exactly as before this
# feature. The child's self-test runs at every start, whatever the flags, and
# logs one "[receipt-pdfs] receipt pdf self-test" line; until it passes, every
# PDF keeps the note. Keep it off until the driver-privacy rule for multi-page
# statements ships (a statement can list other drivers' lines); a local copy
# may switch it on for a test invoice (replica:start --enable).
# DEFAULT OFF. Enable with exactly "true".
RECEIPT_PDF_PAGES_ENABLED=false

# --- Financials overview (R1) --------------------------------------------------
# On, a Super Admin gets GET /api/financials/overview and its .csv: the fleet,
# every truck and every driver for one period, the figures Fleet P&L shows (cost
# settings applied), with checks that the tables agree to the cent. It writes
# nothing. Off, both routes answer 404 FEATURE_OFF before reading the books, and
# the Financials page keeps the Report builder only.
# Before switching it on: a read-only report on production data showing the
# checks ok and the overview equal to Fleet P&L for lastMonth, lastQuarter, ytd
# and last12.
# DEFAULT OFF (it shows money for outside use). Enable with exactly "true".
FINANCIALS_OVERVIEW_ENABLED=false

# --- Cancelled loads list -------------------------------------------------------
# On, a Super Admin gets GET /api/admin/cancelled-loads: every load whose status
# is cancelled, with when it was cancelled, by which account and why, taken from
# the app's own records (the status history and the audit log). A cancel those
# records don't hold (one typed into the sheet, or made before they were kept)
# reads "Not recorded"; nothing is guessed. Read-only: it writes nothing, and the
# rate con opens only through the existing rate-con viewer and its account list.
# Every other role is refused (401/403) whatever the flag. Off, the route answers
# 404 FEATURE_OFF before reading anything, and the Active Loads link stays hidden.
# Before switching it on: scripts/cancelled-loads-report.js, read-only, on
# production data (counts only).
# DEFAULT OFF (a new Super Admin page over cancel records). Enable with exactly "true".
CANCELLED_LOADS_PAGE_ENABLED=false

# --- Mark Paid in a closed month (2026-10) ------------------------------------
# On, a Super Admin can mark a driver invoice Paid when its week touches a
# closed month: the payment is recorded (status Paid, paid_at, paid_by, a
# pay_invoice audit row naming the closed month) and no closed month's revenue,
# P&L, payout or investor figure changes (driver pay never reads invoices). A
# revert may clear a paid stamp only when it was set after every closed month in
# the week was locked; a stamp that existed when a month closed stays, as does
# any stamp or lock time the server cannot read. Off, both are refused in a
# closed month (409 PERIOD_FINALIZED), as before. An invoice week date the
# server cannot read is refused either way.
# DEFAULT OFF (the user's word before it goes on). Enable with true/1/yes/on.
# Before switching it on, run scripts/mark-paid-closed-month-report.js on the
# server; run it again after the first closed-month Mark Paid: the closed
# months' fingerprint must not change.
MARK_PAID_CLOSED_MONTH_ENABLED=false

# --- Invoices in a closed month (2026-10) -------------------------------------
# Closed months are never changed. On, an invoice whose week touches a closed
# month is not generated (nor a weekly Draft regenerated), created by hand,
# deleted or restored: each answers 409 PERIOD_FINALIZED (409
# PERIOD_LOCK_UNREADABLE when the month locks can't be read), with an audit row
# and the remedy: missed days go on an open-month correction draft. The Friday
# batch reports such a driver as skipped, not failed, and names a driver who
# worked that week with no settled invoice (ACTION NEEDED). Submit, approve,
# reject and Mark Paid are unchanged, so an invoice already in such a week can
# still be approved. Each start logs one [invoice-month-lock] line with this
# flag's state and MARK_PAID_CLOSED_MONTH_ENABLED's. Off, everything is as
# before.
# Keep the month-close grace (settlement_grace_days) at 6 days or more while it
# is on: below that, the on-time Friday batch meets a closed month in the first
# week of every month.
# DEFAULT OFF (it moves money). Enable with exactly "true".
INVOICE_CLOSED_MONTH_GUARD_ENABLED=false

# --- Corrections to a locked invoice (2026-10) -------------------------------
# An Approved, Processing or Paid invoice is never changed. On, a Super Admin
# adds a correction to one (POST /api/invoices/:id/corrections; with preview it
# answers what it would add and where, and writes nothing): a dated line naming
# that invoice, carried on the driver's oldest open weekly invoice (Draft,
# Submitted or Rejected) after its week, in an open month. A line is a day of
# that week nothing else pays (it then holds the day, so nothing pays it
# twice), a rate difference on a day the invoice paid, or a signed amount with
# a description. It never takes an invoice below $0 and is never split. With
# no such invoice it waits (no Draft is made) for the driver's next weekly
# invoice or the sweep every 15 minutes. The line prints on the invoice that
# carries it and counts in its total due.
# Off, a new line is refused (403 CORRECTIONS_DISABLED, nothing written).
# Lines that exist keep printing, counting, placing and holding their days, and
# can be voided while their invoice is open, so switching it off strands
# nothing. Each start logs one [approved-invoice-lock] line with this flag's
# state and PERSONAL_RECEIPT_WEEK_ENABLED's.
# Before switching it on: a read-only report on production data (counts and
# amounts, no names): the locked invoices by status with their total due, the
# drivers whose line would land now and those whose line would wait, and the
# sum of total due over live invoices, unchanged by the deploy.
# DEFAULT OFF (it moves money). Enable with exactly "true".
APPROVED_INVOICE_LOCK_ENABLED=false

# --- Row editors and cancelling ------------------------------------------------
# On, PUT /api/data/:rowIndex (on Job Tracking) and PUT /api/load/:loadId refuse a
# save that changes a load's status to cancelled, in any spelling the money filter
# counts as cancelled: 400 CANCEL_NOT_A_ROW_EDIT, nothing saved, the refusal on the
# audit trail. The message names POST /api/dispatch/cancel (the Cancel button),
# which records who cancelled the load, when and why. Editing a load that is
# already cancelled, and moving one off Cancelled, still save. Off, both routes
# save a status as before.
# Before switching it on: a read-only count on production of the row-editor saves
# that set a status to cancelled, i.e. what the refusal would have stopped.
# DEFAULT OFF (it changes what a row save may do). Enable with exactly "true".
ROW_EDITOR_CANCEL_GUARD_ENABLED=false

# --- A daily rate belongs to the driver (2026-10) -----------------------------
# The owner's rule (lib/driver-rate-only.js): from DRIVER_RATE_ONLY_FROM's month
# on (a day counts in its load's Assigned month), a daily-rate driver is paid his
# own Drivers Directory rate, else $250; a truck's Driver pay no longer prices
# his days. It applies on the weekly invoice, the investor view and the payout
# ledger alike. Months before FROM, a month closed before the rule first ran,
# frozen items, payouts and issued invoices never change; each month close
# records whether the rule applied to that month, and a month closed under the
# rule stays as it closed even if the flag is later switched off or FROM moved.
# Switching it off mid-month leaves invoices already issued under the rule at
# the rule's rate, while the open month's ledger goes back to the old rule.
# DEFAULT OFF (it moves money). Enable with true/1/yes/on. Before switching it
# on: review scripts/driver-rate-only-report.js --from=<FROM> on the server.
DRIVER_RATE_ONLY_ENABLED=false
# The first month the rule applies to, YYYY-MM. Required: with the flag on and no
# month here, the rule stays off and each start logs one warning. It must be an
# open month (the report refuses a closed one). Never change it once the rule
# has run.
# DRIVER_RATE_ONLY_FROM=

# --- Blank appointment cells (money plan D, 2026-10) -------------------------
# A completed load's paid days run from its Pickup Appointment to its Drop-off
# Appointment, cut by the ELD (lib/load-pay-days.js payWindow()). When one of
# those cells is blank, or holds no date ("TBD"), the three pay paths have read
# it differently, so two flags line them up. They are separate so driver pay and
# investor payouts can be approved separately; each covers loads whose Assigned
# month (the month their days settle in) is its FROM or later. Months before
# FROM, closed months, frozen items, settled payouts and issued invoices never
# change. Before switching either on, review scripts/blank-pickup-dry-run.js
# --db=app.db --sheet-id=<id> --invoice-from=<FROM> --ledger-from=<FROM> on the
# server: it lists every load, week, invoice and investor-month each flag would
# change, apart.
#
# DRIVER PAY. A blank pickup: the payout ledger and the investor view start the
# window at the Assigned Date, but the weekly invoice pays such a load no day at
# all. On, the weekly invoice starts it at the Assigned Date too (the ELD check
# and the pre-dispatch rule as for any load), and the generate response names
# each such load ("Pickup Appointment blank; days counted from the Assigned
# Date"); the PDF does not. Payouts do not move. An invoice already issued for a
# week is not regenerated: the dry run lists the days it would add.
# DEFAULT OFF (it moves money). Enable with true/1/yes/on.
INVOICE_BLANK_PICKUP_FALLBACK_ENABLED=false
# The first Assigned month it covers, YYYY-MM (e.g. 2026-10). Required: with the
# flag on and no month here, it stays off and each start logs one warning. It
# must be a month that has not closed (the dry run refuses one that has). Never
# change it once the flag has run; once its month has closed with the flag on,
# each start logs one notice saying so (expected; the flag keeps running).
# INVOICE_BLANK_PICKUP_FALLBACK_FROM=
#
# INVESTOR PAYOUTS. A blank drop-off on a delivered load: the weekly invoice
# ends the window at the completion date (Status Update Date), but the payout
# ledger (payouts and Financials) and the investor view pay the pickup day only.
# On, they end it at the completion date too, so ledger driver pay rises and the
# open months' investor payouts fall by the days the invoices already pay. The
# weekly invoice does not move.
# DEFAULT OFF (it moves money). Enable with true/1/yes/on.
LEDGER_BLANK_DROPOFF_FALLBACK_ENABLED=false
# The first Assigned month it covers, YYYY-MM, for the same reasons and with the
# same notices as INVOICE_BLANK_PICKUP_FALLBACK_FROM above (a load with no
# readable Assigned Date is judged by its pickup's month). Never change it once
# the flag has run.
# LEDGER_BLANK_DROPOFF_FALLBACK_FROM=

# --- A truck with no in-service date: its first day (2026-10) ----------------
# A truck's fixed costs (insurance, ELD, truck payment, HVUT, IRP) are charged
# from its in-service month, and a lease counts its days from its in-service
# day. With no in-service date, both fall back to when the truck was added
# (created_at), which SQLite stamps on the UTC clock: from 8 PM EDT (7 PM EST)
# that is already the next day, so a truck added on the evening of a month's
# last day starts paying in the next month, and its lease starts a day late.
# On, that fallback is the business day the truck was added (APP_TIMEZONE, US
# Eastern): its fixed costs in the payout ledger, the investor view, Financials
# and the investor report, its owner's receipt window, and its lease days. A
# truck with an in-service date is not affected.
# DEFAULT OFF (it moves money). Enable with exactly "true". Before switching it
# on, list the trucks with no in-service date added between 8 PM and midnight
# Eastern, and what each would move, on a fresh copy of production.
TRUCK_CHARGE_APP_DAY_ENABLED=false
# The first creation month it covers, YYYY-MM (e.g. 2026-11). Required: with
# the flag on and no month here, it stays off and each start logs one warning.
# Only a truck's creation month can change, and only when that month is FROM or
# later. Nothing reads a month lock, so a month closed before FROM keeps the
# answer it closed with, and a month that closes with the rule on keeps the
# rule's. It must be a month that has not closed. Never change it once the rule
# has run; once its month has closed with the rule on, each start logs one
# notice saying so (expected; the rule keeps running).
# TRUCK_CHARGE_APP_DAY_FROM=

# --- Advance lines on broker invoices (2026-10) -------------------------------
# On, a Super Admin can record an advance the broker already paid on a load
# ("Fuel advance" by default) in the invoice draft editor, and the broker
# invoice prints the line haul, the advance as a deduction, the balance due and
# an editable footnote; the draft bills the balance due. INVOICE-ONLY: Job
# Tracking's Payment, revenue, driver pay, investor payouts and the P&L keep the
# line haul, so a load in a closed month may take a line and no closed month
# changes. Lines are never deleted (one void, with a reason) and every add and
# void is audited. Super Admin only (lib/broker-invoice-lines.js). Off, the
# server builds no table, the draft routes print, bill and record exactly as
# before, and GET/POST /api/loads/:loadId/invoice-lines answer as if they did
# not exist. Changing it needs a restart (the table is built at start).
# DEFAULT OFF (it changes what brokers are billed). Enable with true/1/yes/on.
BROKER_INVOICE_LINES_ENABLED=false

# --- Investor maintenance notice -------------------------------------------
# While the app is mid-update, investors should see (a) a one-shot popup on
# login and (b) a persistent banner saying so — WITHOUT losing access to
# anything. This flag never gates a route or an action; it only controls
# whether GET /api/config/maintenance hands the SPA copy to render (the SPA
# then decides who's "in audience" and whether the popup has already been
# dismissed this session). The wording lives here, not in the client bundle,
# so it can be retuned in production without a redeploy — a `pm2 restart`
# picks up new copy, since, like every other env var in this file, it's read
# once at boot.
# DEFAULT OFF, matching every other flag here that changes what a user sees
# the instant it flips (ROUTEMATE_ENABLED / SCANKIT_ENABLED /
# INVOICE_AUTOGEN_ENABLED / PERIOD_FINALIZE_ENABLED): deploying this code must
# not, by itself, put a banner in front of an investor — an operator opts in
# only once there is a real maintenance window worth announcing.
# WARNING: GET /api/config/maintenance is deliberately unauthenticated (same as
# /api/config/maps-key, so the SPA can fetch it before the session resolves),
# which means anyone who curls it reads this copy while the flag is on. That is
# fine for generic wording and strictly less sensitive than the Maps key — but
# it does mean the words below must never name a client, a dollar amount, or a
# root cause. Write them as if they were on a public status page, because they
# effectively are.
MAINTENANCE_NOTICE_ENABLED=false
# The BANNER headline only. Renders uppercase at font-weight 800, so it eats
# vertical space fast — keep it to a few words, not a sentence. Hard cap 80
# characters; anything longer is truncated at a word boundary (no "…" appended)
# and the server logs a [maintenance-notice] warning at boot.
MAINTENANCE_NOTICE_TITLE=SYSTEM UPDATE IN PROGRESS
# The LOGIN POPUP heading — separate from the banner on purpose. The client
# asked for two different lines: a banner saying the system is updating, and a
# popup saying the application is under maintenance. One shared string could
# only satisfy one of them, and the banner uppercases whatever it is given, so
# putting a full sentence in MAINTENANCE_NOTICE_TITLE would shout it across the
# top of the page. Not uppercased here. Same 80-char cap. Blank falls back to
# MAINTENANCE_NOTICE_TITLE.
MAINTENANCE_NOTICE_MODAL_TITLE=Application is currently under maintenance
# Banner/popup body copy. Keep it short: say the portal is being updated,
# that figures may shift while it is, and that nothing is locked — that last
# part is the whole point, since the client explicitly does not want
# investors to think they've been shut out.
# "Short" is enforced, not just advised: hard cap 400 characters, truncated at
# a word boundary past that (never rejected — a notice that fails closed during
# an incident is worse than a shortened one). The cap exists because the banner
# is sticky: roughly 1,300 characters fills a phone viewport and pins the banner
# over the whole page, which is exactly the "knocked out of the portal" feeling
# the client said to avoid. Aim for the ~170 characters of the default below.
MAINTENANCE_NOTICE_MESSAGE=The portal is being updated behind the scenes right now — some figures may shift while we finish. You're welcome to keep using everything as normal; nothing here is locked.
# The client's own wording for the fine-print line under the message —
# leave verbatim unless the client asks otherwise. Hard cap 200 characters,
# same word-boundary truncation as the other two.
MAINTENANCE_NOTICE_DISCLAIMER=The final settlements are still being calculated.
# investor | all — anything else (typo, blank) falls back to investor.
# 'investor' also covers a Super Admin sitting inside the read-only
# investor-portal preview, so admins previewing that view see exactly what
# the investor sees. 'all' additionally surfaces the notice to Dispatcher/
# Super Admin's own screens, which is rarely what's wanted.
MAINTENANCE_NOTICE_AUDIENCE=investor
# Any string. Bumping it re-shows the popup to everyone who already
# dismissed it this session — the client keys its per-session dismissal flag
# off this exact value, so change it (not just the message) when a dismissed
# notice needs to resurface.
# It lands inside a browser sessionStorage key, so it is sanitized hardest of
# the four: everything outside A-Z a-z 0-9 . _ - is stripped, then capped at 32
# characters. Keep it plain (2, 2026-08-06, aug-window) — if a "bump" differs
# from the previous value only in stripped characters it sanitizes to the same
# string and the popup will NOT resurface.
MAINTENANCE_NOTICE_VERSION=1

# --- GPS geofence radius -----------------------------------------------------
# How close an ELD ping must be to a load's mapped pickup / delivery point for
# the status to advance automatically (At Shipper, In Transit on departure,
# At Receiver). Applies to BOTH zones. Metres.
# 3218.69 m = 2 miles, set by the client 2026-08-06. The prior 1000 m was tight:
# of the first two automatic status changes ever recorded, one fired at 881 m —
# it only just qualified. Wider absorbs imprecise rate-con geocodes and big yards.
# Leave unset to take that default; the value only needs setting to override it.
# 0, negative and non-numeric all fall back to the default — a 0 radius would
# disable every geofence silently, which is precisely the bug this feature spent
# months having.
# ⚠️ Area scales with the SQUARE of this (1000 -> 3218.69 m is 3.2x the radius
# but 10.4x the area). Raising it further makes the arrival hysteresis weaker (a
# highway drive-by spends more consecutive fixes inside the zone) and pushes the
# displayed shipper detention window wider at both ends — arrival is stamped
# earlier, departure later. Nothing bills off those timestamps today.
GEOFENCE_RADIUS_M=3218.69
# Arrival speed ceiling, metres/second. A truck cannot arrive at highway speed,
# so a ping faster than this never triggers At Shipper / At Receiver.
# Default 4.5 m/s (~10 mph). Departure is exempt — being in motion IS its signal.
# Why it exists: the arrival check also wants two consecutive fixes inside the
# zone, which was a real filter at 1000 m (a 2 km chord is barely two fixes at
# 60 mph on a 60 s poll) but not at 3218.69 m, where the chord is 6.44 km — about
# four fixes — so a truck merely passing a shipper on the freeway satisfied it.
# A speed test does not weaken as the radius grows, so it stays correct on a
# retune. It also sharpens detention: arrival now stamps when the truck slows at
# the site, not when it first crosses a line two miles out.
# Looser than the 5 mph "moving" threshold on purpose, so a truck still rolling
# through the gate qualifies on the first fix rather than waiting a poll.
# Non-numeric, 0 and negative fall back to the default. A ping with NO speed
# always passes (undefined/"abc" coerce to NaN, null/"" to 0 — all compare
# false against the ceiling): a missing field must never cause a missed arrival.
GEOFENCE_ARRIVE_MAX_SPEED_MPS=4.5

# --- Arrival recorder (lib/arrival-recorder.js) --------------------------------
# On, each load status history row records who set the status (the session's
# role, or "system" for the geofence), and each "At Shipper" row also the truck's
# position at that moment (its newest clean ELD fix, at most 5 minutes old, inside
# or outside GEOFENCE_RADIUS_M of the mapped pickup point) and the shipper's time
# zone. It records facts only: nothing reads them for pay, and no sheet cell,
# reply, notification or figure changes. The columns exist whatever the flag.
# DEFAULT OFF. On only when exactly "true"; read once at start, and the start-up
# line "[arrival-recorder]" says which.
ARRIVAL_PICKUP_RECORDER_ENABLED=false

# --- Full-haul view: per-load driven miles (GET /api/loads/:loadId/haul) -----
# Zone radius, metres, for the RETROACTIVE geofence replay that decides when a
# truck reached the shipper, left it, and reached the receiver. Defaults to
# GEOFENCE_RADIUS_M so the measurement and the live status transitions agree
# about where a facility ends.
# ⚠️ WHY IT IS A SEPARATE KNOB. GEOFENCE_RADIUS_M drives automation — it writes
# real status rows and fires driver notifications. This one only measures. Anyone
# tightening the measurement (to recover the ~2 mi at each end of the haul that a
# 2-mile zone necessarily excludes) must be able to do so without moving
# dispatch's automation as a side effect.
# Non-numeric, 0 and negative fall back to GEOFENCE_RADIUS_M.
# HAUL_REPLAY_RADIUS_M=3218.69
#
# ⚠️ KILL SWITCH — DEFAULT ON. READ THE SHAPE, NOT THE NAME. This is the
# `!/^(false|0|no|off)$/i` form, so LOAD_HAUL_ELD_ENABLED=true is a NO-OP: the
# only thing this variable can do is turn the ELD half OFF. Same reasoning as
# FUEL_LOW_ALERT_ENABLED — the figure replaces a number a dispatcher would
# otherwise guess, and one that ships disabled is one nobody turns on.
# It is NOT shipped dormant despite the house rule because it writes no money
# table and moves no existing figure: the lane distance is read from
# load_coordinates and deliberately never written back, since /api/investor and
# /api/financials both prefer that column and would silently change.
# Setting it to false leaves the lane + route map rendering exactly as before and
# only blanks the "Actual miles driven" block.
# LOAD_HAUL_ELD_ENABLED=false

# --- Fuel gallons recovery (reads missing volume off stored receipt images) ---
# Gates the APPLY verb of /api/admin/fuel-gallons-recovery only. The PROPOSE verb
# (GET) works regardless, so a run can be inspected in production — hit rate,
# refusals, exact gallons per receipt — before anything writes to a finance row.
# Default off: this UPDATEs expenses.gallons, which feeds cost-per-gallon,
# cost-per-mile and the tank-to-tank MPG a driver plans a fuel stop against.
# Fully reversible when it has run:
#   UPDATE expenses SET gallons = 0, gallons_source = '' WHERE gallons_source = 'ocr';
# Needs GEMINI_API_KEY (503 without it). Each call bills up to 25 Gemini vision
# requests; fuelGallonsLimiter caps both verbs at 6 per 15 min combined.
FUEL_GALLONS_RECOVERY_ENABLED=false

# --- Fuel events: ELD-detected refuels matched to fuel receipts ---------------
# DEFAULT OFF — an enable switch: only true/1/yes/on turn it on. When on, a sweep
# ~3 min after boot and then every 6 h detects refuel episodes in the ELD fuel
# level, records them in fuel_events, writes the odometer onto the matching fuel
# receipt in expenses (cost-per-mile and the monthly fuel breakdown read it), and
# notifies dispatch once per fill that has no receipt. The first-ever run
# backfills the whole retained telemetry window with those alerts suppressed.
# Off: nothing is scheduled and POST /api/admin/fuel-events/run returns 503;
# GET /api/admin/fuel-events is a dry run and works either way.
FUEL_EVENTS_ENABLED=false
# Days of telemetry each sweep re-detects over. Clamped 1-120. Default 10.
FUEL_EVENTS_SCAN_DAYS=10
# Days back a receipt may be matched to a fill — wider than detection because
# receipts are entered late. Clamped 7-180. Default 45.
FUEL_EVENTS_MATCH_DAYS=45

# --- Fuel range buffer + sensor-dropout handling ---
# ⚠️ FUEL_RESERVE_MILES IS A SAFETY MARGIN AND IT WAS REDUCED ON PURPOSE.
# The trip verdict ("can this truck finish the route?") is judged against
# route + this buffer. It was a hardcoded 50 miles with a 10% proportional term;
# after a truck ran dry on 2026-08-17 the client asked for "a 15 mile buffer",
# was told that is 35 miles LESS margin than before, and kept 15.
# FUEL_RESERVE_FRACTION is 0 so the buffer is literally 15 — at the old 0.10 a
# 215-mile route would compute max(15, 21.5) = 22, i.e. quietly not 15.
# Raise either with a `pm2 restart`; no redeploy. Anything non-numeric or
# negative falls back to the shipped default, so a typo can never shrink it.
FUEL_RESERVE_MILES=15
FUEL_RESERVE_FRACTION=0

# The fuel sensor on this fleet drops to 0 WHILE DRIVING — measured 47% of
# readings on one truck, in dropouts lasting hours. So a 0 is not trusted at
# face value: the last credible reading is carried forward minus the fuel burned
# since (from the odometer delta), which can only ever LOWER the estimate.
# FUEL_CARRY_LOOKBACK_HOURS bounds how far back SQL may look for that reading.
# FUEL_CARRY_MAX_HOURS bounds how OLD it may be before we refuse to carry it at
# all and report `stale` with no range. That second one is load-bearing: a dead
# ELD freezes the odometer too, so without it a three-day-old reading subtracts
# zero burn and reports a confident full tank. Keep it well above a real dropout
# (~4 h) and well below "the device is gone".
FUEL_CARRY_LOOKBACK_HOURS=168
FUEL_CARRY_MAX_HOURS=12

# --- Low-fuel warning to the driver ---
# ⚠️ ANOTHER FLAG THAT DEFAULTS **ON**, for the same reason as PII_MASK_ENABLED:
# it is a kill switch, not an enable switch. Before this shipped, NOTHING in the
# app warned a driver about fuel — no socket event, no notification, no toast.
# The only fuel signal was a badge on a collapsed accordion inside one load's
# detail screen, and a driver who runs dry is by definition one who never opened
# it. A safety warning that ships dormant is a safety warning nobody turns on.
# Fires on absolute range (not the route comparison) because it runs on every
# telemetry ping and must cost only local reads. Throttled to one check per
# vehicle per 15 min, and latched so one low-fuel episode sends one alert — the
# latch clears only once range recovers to 1.5x the threshold (i.e. a refuel).
# A stale/absent reading never alerts: we do not know the level, and crying wolf
# on every offline device trains drivers to ignore the alert that matters.
FUEL_LOW_ALERT_ENABLED=true
FUEL_LOW_ALERT_MILES=100

# --- Duplicate-receipt alerting ---------------------------------------------
# ⚠️ ANOTHER FLAG THAT DEFAULTS **ON**. READ THE SHAPE, NOT THE NAME: this is the
# `!/^(false|0|no|off)$/i` form, so EXPENSE_DUPLICATE_ALERT_ENABLED=true is a
# NO-OP — the only thing this variable can do is turn the alert OFF. Same call
# as RATECON_EXTRACT_ALERT_ENABLED: a defect detector that ships off stays off.
# It writes no finance row. A sweep (~4 min after boot, then every
# EXPENSE_DUPLICATE_SWEEP_MINUTES) emails (GMAIL_*) and posts a dispatch
# notification ONCE per duplicate-receipt group (the expense_duplicate_alerts
# ledger), re-opening only if a settled group recurs. Off: nothing is scheduled.
# POST /api/expenses' own write-time duplicate check (409) is separate and
# unaffected either way — this sweep catches the pairs that got past it.
# EXPENSE_DUPLICATE_ALERT_ENABLED=false
# Ceiling on alerts per rolling 24 h, INDEPENDENT of the once-per-group dedupe,
# whose key is built from free-text form fields. sendEmail is SHARED with
# onboarding, investor outreach and the invoice batch, so this stops a bad key
# from exhausting Gmail's quota for all of them. Minimum 1. Default 25.
EXPENSE_DUPLICATE_ALERT_MAX_PER_DAY=25
# Sweep cadence, minutes. Not latency-sensitive: the write-time 409 catches a
# duplicate in the moment. Minimum 15. Default 360 (every 6 h).
EXPENSE_DUPLICATE_SWEEP_MINUTES=360

# --- ELD feed silence (nobody was watching the watchers) ---
# ⚠️ ANOTHER FLAG THAT DEFAULTS **ON**. READ THE SHAPE, NOT THE NAME: this is
# CLAUDE.md's THIRD form, `!/^(false|0|no|off)$/i`, so ELD_STALE_ALERT_ENABLED=true
# is a NO-OP — the only thing this variable can do is turn the detector OFF.
# Same reasoning as FUEL_LOW_ALERT_ENABLED and PII_MASK_ENABLED: it is a kill
# switch, not an enable switch, and the failure it exists to break IS silence.
# A detector that ships disabled is a detector nobody turns on.
#
# ⚠️ IT DELIBERATELY DOES NOT FOLLOW "anything that moves money ships dormant".
# That invariant is about features that WRITE a money figure. This one writes no
# finance row, moves no existing number and changes no pay basis — it reads
# telemetry and tells a human.
#
# WHY IT EXISTS. Nothing detected a dead ELD feed. Measured on production
# 2026-09-19, three shapes of silence were live at once and none had produced a
# single signal in weeks:
#   LogisX-#2372  x78f4qtVukzwiF6ur7D04A   last fix 2026-08-11  (39 days)
#   LogisX-#302   18000505841 (Linxup)     last fix 2026-07-27  (54 days)
#   (orphan)      18000507597 (Linxup)     linked to NO truck, 1 ping/day
#
# ⚠️ AND IT IS A MONEY BUG, not a dashboard gap. getEldTravelDaysByVehicle() is
# coverage-aware: a load window with NO pings falls back to the FULL scheduled
# window instead of reporting zero. Right for a truck that predates the feed,
# wrong for a truck whose device died — the load settles on the `estimated`
# basis, paying MORE driver days than were worked and therefore LESS investor
# profit, and logging nothing that says so. The longer a feed stays dark, the
# more months close on an estimate.
#
# Hourly sweep, alert-once-per-feed ledger (eld_feed_alerts), resolves on the
# next fresh ping and re-opens (preserving first_seen) if the device dies again.
# A re-opened feed alerts again only once its last alert is 24 h old, so a
# device hovering at the trickle floor mails once a day, not on every flip.
# Turning it off and `pm2 restart logistics-app` restores the previous silence
# byte for byte, with no redeploy.
ELD_STALE_ALERT_ENABLED=true

# Hours of silence on a LINKED, Active, unretired truck before it alerts —
# condition (a). Respects trucks.retired_at, so retiring a truck stops the alert
# at the source. Below ~6 this would fire on a parked weekend truck whose device
# sleeps; the two production outages above were 39 and 54 DAYS, so 24 is nowhere
# near the edge.
ELD_STALE_HOURS=24

# Distinct fixes required in a rolling 24 h — condition (c), the trickle
# detector. ⚠️ THIS IS THE CONDITION (a) IS STRUCTURALLY BLIND TO: a device that
# degrades to one ping a day is NEVER stale by the clock (its newest fix keeps
# refreshing) while carrying no usable position history at all, and the
# coverage-aware pay math happily builds a day out of one sample. Healthy trucks
# here write ~5,760 rows/day, so 10 is three orders of magnitude below normal and
# still comfortably above the 1/day trickle. Counted as
# COUNT(DISTINCT location_date_ms), so a device re-pushing one timestamp cannot
# fake a healthy feed.
ELD_STALE_MIN_FIXES=10

# How recently an UNLINKED device must have written telemetry to still count as
# part of our data stream — condition (b), which catches an ELD pushing rows we
# file under no truck. ⚠️ DELIBERATELY WIDER THAN ELD_STALE_HOURS: an orphan is a
# CONFIGURATION defect, not a liveness one — it is mis-linked whether or not it
# pinged in the last hour. Judged on 24 h, device 18000507597 (last seen four
# days before this shipped) would already have aged out of the only window that
# could report it. Telemetry purges at 90 days, so the data bounds this anyway.
ELD_UNLINKED_LOOKBACK_HOURS=168

# Driver availability (R11): a driver's recorded time off (vacation, off duty,
# other), kept apart from every truck status. DEFAULT OFF; enable with
# true/1/yes/on, off in production until the owner approves it. On:
#   - Super Admin and Dispatcher record, edit, end early and cancel periods on
#     the Drivers directory (at most 60 days each; a Dispatcher at most 30 days
#     back, and ends a period early no earlier than yesterday); a driver sees
#     his own, read-only; investors see nothing;
#   - the ELD silence alert above pauses while a truck's driver is off, and for
#     ELD_STALE_HOURS after 00:00 Eastern on his first day back, then a feed
#     still dark alerts again;
#   - assigning him a load inside his off days answers 409 DRIVER_OFF_DUTY and
#     goes through, audited, once the dispatcher confirms ("Assign anyway").
# It touches no truck, no pay day, no invoice, payout or Financials figure.
# Off, nothing reads or writes its table (the additive migration still runs, so
# turning it on needs no other step), and rows saved while it was on stay inert.
DRIVER_AVAILABILITY_ENABLED=false

# The driver's own time-off screen (R11 follow-up). DEFAULT OFF; enable with
# true/1/yes/on, and it works only while DRIVER_AVAILABILITY_ENABLED is on (with
# that off, this does nothing). Off in production until the owner approves it,
# after a check on the local copy. On, the driver app shows a read-only "My time
# off" card on its Kit tab and a one-line banner on its Loads list (while he is
# off, and in the 7 days before): his own current and upcoming periods, with the
# dates, the kind and whether he is off now. Never the reason, the history, who
# recorded a period, or anyone else's. Off, the driver app's payload carries no
# time-off key and the app shows nothing; staff editing and every other part of
# driver availability run as before.
DRIVER_TIME_OFF_SCREEN_ENABLED=false

# Warn when time off covers loads the driver already has (R11b). DEFAULT OFF;
# enable with true/1/yes/on, and it works only while DRIVER_AVAILABILITY_ENABLED
# is on (with that off, this does nothing). Off in production until the owner
# approves it, after a check on the local copy. On, recording time off, or moving
# or extending it onto days it did not cover, reads Job Tracking first: when his
# live loads fall inside the new days, the save answers 409 DRIVER_HAS_LOADS
# listing them and writes nothing; "Save anyway" re-sends with those loads echoed
# and records a confirmation per load, so his truck's dark-ELD alert still fires
# while one of them covers today. Loads with no readable date are skipped. If Job
# Tracking can't be read, the save goes through unchecked and says so (and the
# audit line notes it). It changes no load and pays nothing. Off, create and edit
# never read Job Tracking and answer exactly as before; rows saved without it
# keep their trucks' alerts paused during his loads (no backfill).
DRIVER_AVAILABILITY_LOADS_WARNING_ENABLED=false

# The time-off ELD check. DEFAULT OFF; enable with true/1/yes/on, and it works
# only while DRIVER_AVAILABILITY_ENABLED is on (with that off, this does nothing).
# Off in production until the owner approves it, after the read-only report
# (scripts/time-off-eld-check-report.js) on the local copy and on production. On,
# a job judges each finished day of recorded time off once a day from 06:00 on the
# business clock, from the ELD of each truck the driver held and his own app status
# updates, with no one approving: Confirmed (parked, or dark without moving;
# "Confirmed (no ELD data)" for a day with no ELD data at all), Not confirmed (the
# truck moved, or his own account updated a load's status), Requested (ELD data that
# conflicts: a device that may be in another vehicle, an engine that ran while the
# ELD was dark, a truck that changed hands while dark) or Checking (waiting for the
# ELD to report again). Staff see the results on the driver's time off and get one
# in-app notice when a day reads Not confirmed; the driver app is told only that the
# check is on. It never cancels time off, changes a pay day, invoice or payout, or
# sends an email. A result's miles and times are removed 90 days after it is final
# (its verdict stays), with this flag on or off. Off, no job runs and no answer
# carries an ELD key.
DRIVER_TIME_OFF_ELD_CHECK_ENABLED=false

# --- Driver emergency contacts (2026-10) ---------------------------------------
# Two to five people per driver account: a name, how they are related to the
# driver, and a phone number. On, the driver reads and saves his own list
# (GET/PUT /api/driver/me/emergency-contacts), and a Super Admin or Dispatcher
# reads and saves the list of the driver account a Drivers page row names
# (GET/PUT /api/drivers-directory/:id/emergency-contacts). Every other role is
# refused. The driver app's payload carries how many are on file, never the
# contacts. Each add, change and delete writes one audit row that keeps the
# phone's last 4 digits only, never a contact's name or relationship. Contacts
# are deleted with the account, and a refreshed local or staging copy carries
# none (names "REDACTED", numbers 555-0100).
# On, a new driver's onboarding signing step also waits for two contacts: with
# every document signed he stays documents_pending (no Drivers page row, no
# "Documents Received" emails) until they are saved, which moves him on. A
# driver already past that step (waiting on the drug test) is never held back.
# Off, all four routes answer 404 FEATURE_OFF, the payload has no
# emergencyContacts key and the signing step needs the documents only.
# Contacts saved while it was on stay, unread.
# Before switching it on: scripts/emergency-contacts-report.js, read-only, on
# production data (counts and ids only).
# DEFAULT OFF (personal data about third parties). Enable with exactly "true".
EMERGENCY_CONTACTS_ENABLED=false

# --- Request a fresh signature ---------------------------------------------------
# A Super Admin asks a driver, from the Drivers page, to sign one policy document
# again (equipment, mobile or substance policy; the contractor agreement and the W-9
# are refused), with a reason of at least 10 characters
# (POST /api/admin/onboarding/:userId/documents/:docKey/request-signature, and
# .../cancel-signature-request to withdraw it). The request changes nothing on the
# document: the signed original stays live, with its evidence. The driver gets one
# in-app notice and a "Please sign again" card, never an email or a text, and is
# never told the reason or who asked. When the driver signs, the original is copied
# into the evidence archive first, its evidence (signature, time, IP, browser,
# consent, sha256) goes into the document's history, and the fresh copy carries
# today's date (wrapped when POLICY_FIELD_WRAP_ENABLED is on). A failed signing
# keeps the original live and unchanged. It never re-runs the onboarding steps: no
# email, no Carrier sheet write, no directory change.
# Off, both routes answer 404 FEATURE_OFF, a signed document answers "Already
# signed" as before, and no answer carries the new keys.
# DEFAULT OFF (documents drivers sign). Enable with exactly "true".
ONBOARDING_RESIGN_ENABLED=false

# --- Driver training videos ------------------------------------------------------
# DEFAULT OFF; enable with true/1/yes/on. On, the driver app's payload
# (GET /api/driver/:driverName) carries `trainingVideos`, decided on the server
# from the driver's own onboarding status alone (lib/driver-training-videos.js):
# "onboarding" once the signing step is accepted (documents_signed, waiting on
# screening), a "Training videos" card under "Documents Received!" on the lock
# screen; "kit" once fully onboarded (or an older account with no onboarding
# record), the same card at the bottom of the Kit tab; nothing while still
# signing. The drug-test columns are never read for it, and the card never
# mentions a result.
# The ELD video is RouteMate's own, on YouTube's no-cookie host
# (www.youtube-nocookie.com): nothing goes to YouTube until the driver taps the
# player, and an "Open it on YouTube" link is always shown. The app's first
# third-party frame, so the site's Content-Security-Policy (set by nginx, not
# the app) must allow that one origin in frame-src before this goes on; until
# then the player is refused and only the link works. Off, the payload has no
# trainingVideos key and the app shows nothing new.
DRIVER_TRAINING_VIDEOS_ENABLED=false

# Rate-con driver instructions (lib/driver-instructions-runtime.js). DEFAULT OFF;
# enable with true/1/yes/on. Off in production until the owner approves it. On,
# a second Gemini call reads each new rate-con PDF (the drag-and-drop upload, and
# a sweep every 5 minutes of the RATECON_DRIVE_FOLDER_ID folder) for what a driver
# may be shown: references, requirements, instructions. Never money, carrier
# terms, account numbers or any phone or email. Staff review and correct it on
# GET / PUT /api/loads/:loadId/driver-instructions. It has its own Gemini budget
# (6 calls per 15 minutes, 60 a day) and pauses while load ingestion saw a 429.
# Off: no sweep, no Gemini call, every instructions route answers 404.
RATECON_DRIVER_INSTRUCTIONS_ENABLED=

# The driver's own instructions screen. DEFAULT OFF; works only while
# RATECON_DRIVER_INSTRUCTIONS_ENABLED is on (and the deny list below is set). On:
# GET /api/driver/loads/:loadId/instructions serves the load's own driver only the
# published version, re-filtered on every read; the driver app shows it first on
# the load, with critical-requirement chips on the load list (codes only), and a
# change dispatch publishes reaches the driver's app at once. Off: that route
# answers 404 and the driver app shows nothing of it.
DRIVER_LOAD_INSTRUCTIONS_SCREEN_ENABLED=

# REQUIRED BEFORE EITHER FLAG ABOVE DOES ANYTHING: the carrier's own account
# numbers, comma-separated, matched digits-only against every instruction. A
# production secret: set only in production's .env, never in this file, a log or
# a ticket. Unset or empty: both flags are treated as off and the server logs one
# warning per start naming this variable. Every start, whatever the flags, logs one
# line with the count only, never a value: "[driver-instructions] deny list: N
# value(s) loaded", "... deny list: not set (0 values)", or, when an entry has
# fewer than 5 or more than 20 digits, "... N value(s) loaded, M ignored (unusable:
# ...)" as a warning. That line is the check before any rate-con flag goes on:
# the loaded count must equal the number of distinct numbers entered, one per
# comma-separated entry, with none ignored. Entries are split only at commas,
# semicolons and line breaks, so two numbers with only a space between them are
# read as one value (or ignored, when together they pass 20 digits) and the
# count comes out short; an ignored entry is a number nothing checks for. The name carries SECRET on purpose: the replica
# export (npm run replica:pull) never copies a name holding SECRET, in every
# version of its rules, so an older checkout can't copy it either (a replica's
# start line says "not set (0 values)"). The old name,
# CARRIER_ACCOUNT_NUMBERS_DENY, is no longer read: when it is set the server
# ignores it and logs one warning per start naming this one.
CARRIER_ACCOUNT_NUMBERS_DENY_SECRET=

# The Google account n8n archives rate cons with. The sweep reads only folder
# files that this account both owns and last modified. Unset: no sweep
# (drag-and-drop still works).
RATECON_DRIVE_UPLOADER_EMAIL=

# Ceiling on alerts per rolling 24 h, INDEPENDENT of the per-feed dedupe — the
# backstop that still holds if the key space is ever wrong. Same reasoning as
# EXPENSE_DUPLICATE_ALERT_MAX_PER_DAY: sendEmail is SHARED with driver
# onboarding, investor outreach and the weekly invoice batch, so exhausting
# Gmail's quota here would silence every channel this feature needs. Counted as
# delivered SENDS (a small log in server_state), not ledger rows, which a
# re-open overwrites.
ELD_STALE_ALERT_MAX_PER_DAY=25

# Sweep cadence, minutes. The condition is measured in days, so this is not
# latency-sensitive; it only bounds "how late is the first warning".
ELD_STALE_SWEEP_MINUTES=60

# --- Daily integrity check (lib/integrity-check.js) ---
# Every day at 8:00 AM on the business clock (APP_TIMEZONE) the server reads Job
# Tracking and app.db and emails ADMIN_NOTIFY_EMAIL (only; nothing when it is
# unset) when it finds: a load whose Pickup Appointment became blank, an Assigned
# Date that changed after it was set, a new n8n Assigned Date that is not in
# Eastern time (matched to the rate-con email's Date header; the RATECONs label is
# read like the rate-con reconcile reads it, EXAMINE and BODY.PEEK, with
# GMAIL_USER / GMAIL_APP_PASSWORD), and an approved receipt on no invoice for more
# than 7 days (receipts booked to a closed month are left out; each receipt is
# named once, then counted). A clean day logs one line. It writes only its own
# two tables, integrity_check_loads (the values it last saw) and
# integrity_check_receipts (the receipts it named); its first run records the
# values as a baseline and reports changes from the next. A restart after 8 AM
# runs that day's check once, about 100 s after boot.
# ⚠️ DEFAULTS ON: a kill switch (the !/^(false|0|no|off)$/i shape), so "true" is a
# no-op and only false/0/no/off turns it off. It moves no money and writes no
# business data. scripts/integrity-check.js --print runs the same checks by hand,
# read-only, and prints what it would send.
INTEGRITY_CHECK_ENABLED=true

# --- Orphaned chat-attachment sweep (DELETES files that are NOT backed up) ----
# A file uploaded via POST /api/chat/attachment but never sent in a message
# stays in uploads/chat/ forever. sweepOrphanedChatAttachments() runs 5 min
# after boot and then every 24 h whatever this is set to.
# DEFAULT OFF — an enable switch: only true/1/yes/on turn it on. Off is REPORT
# ONLY: the sweep logs how many orphans and MB it WOULD reclaim and deletes
# nothing. ⚠️ On, it deletes them, and uploads/ is NOT in the nightly backup, so
# a wrong delete is permanent. It only ever touches `chat_*` files that no
# message references, and removes nothing if the messages table can't be read.
CHAT_ORPHAN_SWEEP_ENABLED=false
# Minimum age, hours, before an unreferenced file counts as an orphan. A WEEK on
# purpose: the client reuses an uploaded attachment's URL after a failed send,
# so a shorter floor can reap a file somebody is about to send again. 0 or
# non-numeric falls back to 168; ⚠️ a NEGATIVE value clamps to 1 hour, not 168.
# Default 168.
CHAT_ORPHAN_MIN_AGE_HOURS=168

# --- Voice notes in Messages (POST /api/messages/voice) ---
# Anyone in a conversation records a voice note (AAC in MP4, 3:00 at most,
# 4 MB); the others play it. The server checks the bytes, measures the length
# and stores the audio under storage/voice-notes/ (outside uploads/, not in the
# nightly backup). Who may play a note is decided by account id: staff, and the
# Driver or Investor account in the conversation.
# DEFAULT OFF — an enable switch: only true/1/yes/on turn it on. It gates
# RECORDING only: notes already sent stay playable with it off. Switch it on only
# after the client release, the nginx Permissions-Policy / CSP check on staging
# and the on-device checks (iPhone Safari, Android Chrome).
MESSAGE_VOICE_NOTES_ENABLED=false
# Per account per Eastern day, MB of voice notes (429 past it). Default 40.
VOICE_NOTE_DAILY_MB=40
# Sends are refused (507) while the data disk has less than this many GB free;
# staff get one notice a day. Default 2.
VOICE_NOTE_MIN_FREE_GB=2
# Days a voice note's audio is kept; the row stays and says it is no longer
# available. Default 180.
VOICE_NOTE_RETENTION_DAYS=180
# The first day (YYYY-MM-DD, Eastern) the daily sweep DELETES audio past its
# retention and voice files no message names (older than an hour). Unset: the
# sweep only REPORTS what it would remove. ⚠️ Deleted audio is not backed up.
VOICE_NOTE_SWEEP_APPLY_FROM=

# --- PII masking on read (SSN / EIN / bank numbers) ---
# ⚠️ THIS FLAG DEFAULTS **ON**. The dormant flags in this file ship off because
# enabling them moves money, sends mail, or spends on a metered API — for
# those, off is the safe direction. This one withholds SSNs, tax ids,
# bank routing/account numbers and licence numbers from API responses, and for a
# control like that "off" IS the failure mode. A masking layer that ships
# disabled is not a control, it is a comment.
#
# So this is a KILL SWITCH, not an enable switch. Set it to false and
# `pm2 restart logistics-app` if masking ever obstructs a real admin workflow —
# that restores the previous behaviour byte for byte, with no redeploy.
# (Verified: with the flag off, GET /api/applications/:id returns the raw SSN
# exactly as it did before this change.)
#
# It is safe to default on because masking removes no CAPABILITY. The full
# values stay one click away behind two audited, rate-limited routes:
#   GET /api/applications/:id/sensitive            (SSN + licence)
#   GET /api/investor-applications/:id/sensitive   (EIN/SSN + routing + account)
# Each writes an audit_trail row. That is the actual point: `super_admin` is a
# SHARED login, so no control can say WHICH person read a value — but a reveal
# can at least be an event on the record rather than a silent side effect of
# opening a page.
#
# ⚠️ This flag does NOT govern the ownership guard on signed onboarding PDFs
# (uploads/onboarding-signed, uploads/investor-onboarding-signed). That is a
# straight vulnerability fix — any authenticated Driver could previously read
# any other person's W-9 by guessing the filename — and it is unconditional by
# design. Turning masking off does not re-open it.
PII_MASK_ENABLED=true

# BROKER_CONTACT_VALUE_REDACTION_ENABLED — defaults ON, a kill switch like
# PII_MASK_ENABLED, over free-text value redaction only. Every role but Super
# Admin is served no broker email or phone in any load field, notice or stored
# address, whatever holds it (lib/broker-contact.js): contact inside text reads
# "[contact withheld]", a cell holding only contact is blank, and such a cell is
# read-only for them (409 CONTACT_CELL_READ_ONLY). Set to "false" and restart
# only if that obstructs a real workflow; Super Admin responses are the same
# either way. Whatever this says: the broker contact COLUMNS ("Broker Contact
# Name", "Phone Number", "Email") are blank for them, the rate-con extract
# answers them with its broker fields empty (the load gets the rate con's own),
# and an email or phone typed into Contract ID is refused (400 CONTACT_NOT_ALLOWED).
BROKER_CONTACT_VALUE_REDACTION_ENABLED=true

# WITHHELD_LOAD_REFS_ENABLED — DEFAULT OFF, an enable switch: only true/1/yes/on
# turn it on (the Dispatcher Load ID plan, PR 2). A Load ID that holds broker
# contact reaches every role but Super Admin as its shown text
# ("QA-[contact withheld]"), so a Dispatcher can see such a load but can't open,
# edit, assign or override it. On, a Dispatcher is also served an opaque key
# beside each such ID ("wk-" and 27 characters; it carries nothing of the ID and
# changes at every server start) and the load's pages open it by that key. A key
# the server no longer knows answers 404 LOAD_KEY_UNKNOWN and the page reloads.
# The ID text never reaches the Dispatcher, and such a load has no tracking link
# to copy ("Ask a Super Admin for this link"). Super Admin, Driver and Investor
# answers are the same either way, and it does nothing while
# BROKER_CONTACT_VALUE_REDACTION_ENABLED is off. Whatever this says, a Dispatcher
# sees such a load's documents by type and upload time only. Switch it on after
# the replica check and Arvin's yes.
WITHHELD_LOAD_REFS_ENABLED=false
