# LogisX environment template.
# Copy this file to .env and fill in real values. The live .env is git-ignored;
# this template is checked in so the team knows which keys exist.

# --- Server ---
PORT=3000
SESSION_SECRET=change-me-in-production

# --- Parallel-dev port overrides (per-worktree, optional) ---
# When running multiple worktrees side-by-side, give each its own ports.
# VITE_DEV_PORT is the Vite dev server port; VITE_API_TARGET is the Express
# backend that Vite proxies /api and /socket.io to. Leave both unset for the
# default 5173 → http://localhost:3000 pairing.
# VITE_DEV_PORT=5173
# VITE_API_TARGET=http://localhost:3000

# --- Google Sheets / Drive / Maps ---
# Spreadsheet IDs. Leave unset to use the production sheets; override in
# staging (or any non-prod env) to point at a separate copy. The service
# account (sheets-bot@logistics-app-491014.iam.gserviceaccount.com) must be
# shared on whichever sheet you point at.
SPREADSHEET_ID=
ARCHIVE_SPREADSHEET_ID=
# Drive folder ID for POD uploads. Optional — uploads skip Drive when empty.
GOOGLE_DRIVE_FOLDER_ID=
# Required for the dashboard maps, route directions, and geocoding.
GOOGLE_MAPS_API_KEY=

# --- Email (driver onboarding + investor outreach) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Gemini Vision (expense receipt OCR) ---
# Optional. When unset, the receipt-OCR endpoint returns 503 and the driver
# form silently falls back to manual entry.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# --- ELD / telematics integration (provider-neutral) ---
# LogisX pulls live GPS, geofence auto-status, fleet health (fault codes, DVIR),
# fuel/IFTA, and the ELD-verified driver-pay "active days" from an ELD provider.
# The concrete vendor API lives behind one adapter layer (lib/eld/) and the
# active provider is chosen by ELD_PROVIDER, so switching vendors is one flag.
#
# ELD_PROVIDER selects the adapter: "routemate" (default — current production
# behavior, unchanged) or "apollo". Leave unset/"routemate" to keep today's
# behavior; Apollo ships DORMANT until its key is activated and staging is
# verified, then flip this to "apollo" (rollback = flip back).
ELD_PROVIDER=routemate

# Shared polling cadences — apply to whichever provider is active. Each falls
# back to the matching ROUTEMATE_POLL_* below (then the built-in default) when
# unset, so an existing Routemate deployment keeps its cadence with no changes.
ELD_POLL_LIVE_SEC=60
ELD_POLL_FAULTS_SEC=300
ELD_POLL_DAILY_HOUR=4

# --- Routemate provider (default; current production ELD) ---
# Base URL is the production Routemate cloud. Override only for sandbox use.
ROUTEMATE_BASE_URL=https://cloud.routemate.ai
# Issued by Routemate. Sent as the X-Api-Key header on every request.
ROUTEMATE_API_KEY=
# Master kill switch for the Routemate adapter. Leave false until the API key is
# wired and at least one truck is linked to a Routemate vehicle. When false, all
# Routemate sync intervals are dormant and the manual probe
# (POST /api/admin/eld/sync-now) returns 503.
ROUTEMATE_ENABLED=false
# Legacy per-provider cadences. Still honored as the fallback for the shared
# ELD_POLL_* above; harmless when the Routemate adapter is inactive.
ROUTEMATE_POLL_LIVE_SEC=60
ROUTEMATE_POLL_FAULTS_SEC=300
ROUTEMATE_POLL_DAILY_HOUR=4

# --- Apollo ELD provider (new; ships dormant) ---
# Apollo ELD resells the ATCompass / ELD Roadmap platform. Set ELD_PROVIDER=apollo
# to activate (after the key is wired AND trucks are re-linked to Apollo AssetIds).
# Base URL is the production Apollo content API — standard HTTPS, note the :9103
# port. Override only for sandbox use.
APOLLO_BASE_URL=https://content.eldroadmap.com:9103
# Issued by the Apollo reseller. Sent as the HOSClientApiKey field — a query
# param on GETs (URL-encoded; the key may contain a literal "?"), a body field on
# POSTs. LEAVE BLANK here: the real key lives ONLY in the server .env, never in
# the repo. The initial reseller key returned code:7 (INVALID_KEY); an activated
# key is required before Apollo can pull live data.
APOLLO_API_KEY=
# Master kill switch for the Apollo adapter. Leave false until the key is
# activated and verified on staging. When false (or the key is unset), the Apollo
# smoke test / sync returns 503 and no Apollo polling runs.
APOLLO_ENABLED=false

# --- ScanKit.io document scanning ---
# Powers the document scanner (driver POD/BOL, expense receipts, admin uploads)
# via POST /api/documents/scan — server-side only, never exposed to the client.
# Base URL is the production ScanKit API; override only for sandbox use.
SCANKIT_BASE_URL=https://api.scankit.io
# Issued by ScanKit (format sk_...). Sent as the Authorization: Bearer header.
SCANKIT_API_KEY=
# Master kill switch. Leave false until the API key is wired. When false (or the
# key is unset), POST /api/documents/scan returns 503 and the client scanner
# falls back to attaching the raw photo (receipts simply skip enhancement).
SCANKIT_ENABLED=false
# ScanKit is credit-billed: charged per successful scan (HTTP 2xx); 4xx errors
# like 402 are NOT billed and NOT retried. When credits run out the scan endpoint
# returns 402 and the driver app falls back to attaching the raw photo — the POD
# still uploads, just without crop/deskew/lighting enhancement. Setting
# SCANKIT_ENABLED=false fully disables scanning (endpoint returns 503 + the same
# raw-photo fallback). Recovery / credit top-up / key-rotation runbook:
# docs/runbooks/scankit-billing.md

# --- Automatic weekly invoice generation ---------------------------------
# Master kill switch for the Friday 4:00 PM America/New_York (DST-aware) batch
# that generates AND auto-submits every driver's weekly invoice (drivers kept
# forgetting to submit). Approval stays manual — nothing is auto-approved/paid.
# DEFAULT OFF (this moves money): stays dormant until explicitly enabled here,
# matching ROUTEMATE_ENABLED / SCANKIT_ENABLED. Enable with true/1/yes/on.
# On first enable it seeds a baseline so it never retroactively bills a past
# week — the first real run is the next Friday. A boot catch-up covers a restart
# across 4 PM; a week with drivers who worked-but-weren't-billed retries (bounded)
# and emails/notifies info@logisx.com with an ACTION-NEEDED summary.
INVOICE_AUTOGEN_ENABLED=false
