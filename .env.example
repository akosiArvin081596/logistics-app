# LogisX environment template.
# Copy this file to .env and fill in real values. The live .env is git-ignored;
# this template is checked in so the team knows which keys exist.

# --- Server ---
# Interface the server binds to. Defaults to 127.0.0.1 (loopback ONLY) so the
# app is reachable exclusively through nginx. Do not set this to 0.0.0.0 on a
# public host: it bypasses TLS, every nginx security header, and — because
# `trust proxy` is on — makes every IP-keyed rate limiter forgeable.
BIND_HOST=127.0.0.1
PORT=3000
SESSION_SECRET=change-me-in-production

# --- Session cookie SameSite (normally UNSET — unset means "lax") ---
# SameSite is the single attribute deciding whether a browser attaches the
# session cookie to a request some OTHER site made, so it is the whole CSRF
# question. Production ran "none" from 2026-05-17 for a driver-mobile-view
# prototype that was never in this repo and is set up nowhere; it was tightened
# to "lax" on 2026-08-09.
#
# Leave this UNSET. "lax" still carries the cookie on a top-level cross-site GET
# navigation, so links in onboarding/outreach email, bookmarks and QR codes all
# still land logged in — while cross-site POSTs, cross-origin fetches and every
# subresource load (<img>, <iframe>) no longer carry it.
#
# Values: lax (default) | strict | none
#   strict — a user following a link from an email or an external site lands
#            LOGGED OUT. Almost certainly not what you want here.
#   none   — reopens the CSRF class app-wide. There is no CSRF token in this
#            app, so only the per-route crossSiteGuard mounts would remain.
#            REQUIRES a Secure cookie (NODE_ENV=production); it is refused and
#            downgraded to "lax" otherwise, because browsers reject None without
#            Secure and the cookie would be dropped entirely — i.e. every user
#            logged out on every request. Set it only alongside
#            DRIVER_MOBILE_ORIGINS, to serve a genuine cross-origin browser
#            client. Both are needed; neither alone is enough.
# Anything unrecognized falls back to "lax". Every non-default choice warns at
# boot. This exists as the one-line, no-deploy way back from a bad tightening
# (set it, pm2 restart) — it is a rollback switch, not a feature flag.
# SESSION_COOKIE_SAMESITE=lax

# --- Cross-origin browser clients (normally UNSET, and should stay that way) ---
# Comma-separated origin allowlist that receives permissive CORS headers,
# including Access-Control-Allow-Credentials. DEFAULTS TO EMPTY: no cross-origin
# browser client. It used to default to "https://localhost:3002,
# https://192.168.8.106:3002", which shipped to production and was worse than
# dead weight — that list is also the FIRST leg of crossSiteGuard, so those two
# dev addresses were a standing bypass of the guards on the four money routes.
# Setting this alone does NOT re-enable a credentialed cross-origin client; the
# cookie is SameSite=lax, so SESSION_COOKIE_SAMESITE=none is required too.
# DRIVER_MOBILE_ORIGINS=

# --- First-time setup recovery (normally UNSET, and should stay that way) ---
# POST /api/auth/setup creates the very first Super Admin with no authentication.
# It is refused once accounts exist, and ALSO refused when `users` is empty but
# the database still carries a live system's data (expenses / trucks / settled
# payouts / an audit trail) — otherwise anything that truncates `users` would
# republish an unauthenticated admin minter on the production hostname.
#
# This token is the ONLY way past that latch, and it exists because the opposite
# failure is just as bad: there is no password-reset script in this repo, so an
# owner with no Super Admin account has no scripted way back in. Setting an env
# var needs shell access to the box, which is the same authority such a script
# would have required.
#
# Leave it unset in normal operation. Set it, restart, recover the account,
# then unset it and restart again. Never commit a real value.
#
# MINIMUM 24 CHARACTERS — anything shorter is ignored (with a startup warning),
# because the comparison is length-first and a short token is both guessable and
# length-leaking. Generate with: openssl rand -hex 32
# SETUP_RECOVERY_TOKEN=

# --- Parallel-dev port overrides (per-worktree, optional) ---
# When running multiple worktrees side-by-side, give each its own ports.
# VITE_DEV_PORT is the Vite dev server port; VITE_API_TARGET is the Express
# backend that Vite proxies /api and /socket.io to. Leave both unset for the
# default 5173 → http://localhost:3000 pairing.
# VITE_DEV_PORT=5173
# VITE_API_TARGET=http://localhost:3000

# --- Google Sheets / Drive / Maps ---
# Spreadsheet IDs. Leave unset to use the production sheets; override in
# staging (or any non-prod env) to point at a separate copy. The service
# account (sheets-bot@logistics-app-491014.iam.gserviceaccount.com) must be
# shared on whichever sheet you point at.
SPREADSHEET_ID=
ARCHIVE_SPREADSHEET_ID=
# Drive folder ID for POD uploads. Optional — uploads skip Drive when empty.
GOOGLE_DRIVE_FOLDER_ID=
# The SERVER key. Used for every outbound Google call the app makes itself:
# Geocoding, Distance Matrix, Routes, and Places (New) searchNearby/searchText
# — i.e. the dashboard maps' route directions, geocoding, and the diesel
# truck-stop POI layer on the tracking map (GET /api/poi/fuel-stops).
# Restrict this one by IP ADDRESS (the VPS) in the Google Cloud console.
# It must never be sent to a browser.
GOOGLE_MAPS_API_KEY=
# The BROWSER key — the only value GET /api/config/maps-key hands out, and the
# one the Maps JavaScript API + Places Autocomplete run on. That endpoint is
# unauthenticated by necessity (the public /apply, /invest and /track/:loadId
# pages load a map before any session exists), so treat this key as PUBLISHED:
# anyone can read it with one curl. Restrict it by HTTP REFERRER to the app's
# own hosts and by API to Maps JavaScript + Places.
#
# Optional. Unset falls back to GOOGLE_MAPS_API_KEY, which is the pre-split
# behaviour — and that single shared key CANNOT be restricted at all, because
# a referrer restriction breaks every server call and an IP restriction breaks
# every map. Two keys is what makes any restriction possible.
GOOGLE_MAPS_BROWSER_KEY=

# --- Google API transport (dead keep-alive sockets) -------------------------
# Both optional; the defaults are the shipped values and are what you want.
# Added after the 2026-08-06 dashboard outage, where a request handed to a
# half-open pooled socket blocked ~150s (a TCP retransmission budget) while
# Google itself answered the same read in ~470ms. See the long note beside
# google.options() in server.js before changing either.
#
# Per-request ceiling on EVERY Sheets/Drive call, and on the OAuth token
# exchange. node-fetch applies it twice and independently — once until response
# headers, once over the body read — so a large slow read is not charged for the
# server's think time. A timed-out request is retried on a fresh socket (GET/PUT
# only; never POST, which would duplicate a values.append).
GOOGLE_API_TIMEOUT_MS=15000
# Idle timeout on FREE (pooled) sockets only — in-flight requests are never
# affected. 5000 matches Node >=19's own https.globalAgent default; do NOT raise
# it, that widens the window in which a stale socket can be drawn.
GOOGLE_SOCKET_IDLE_MS=5000

# --- Email (driver onboarding + investor outreach) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Gemini Vision (expense receipt OCR) ---
# Optional. When unset, the receipt-OCR endpoint returns 503 and the driver
# form silently falls back to manual entry.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Routemate ELD/telematics integration ---
# Base URL is the production Routemate cloud. Override only for sandbox use.
ROUTEMATE_BASE_URL=https://cloud.routemate.ai
# Issued by Routemate. Sent as the X-Api-Key header on every request.
ROUTEMATE_API_KEY=
# Master kill switch. Leave false until the API key is wired and at least one
# truck is linked to a Routemate vehicle. When false, all sync intervals are
# dormant and the manual probe (POST /api/admin/routemate/sync-now) returns 503.
ROUTEMATE_ENABLED=false
# Polling cadences (used in Phase 2+; harmless when ROUTEMATE_ENABLED=false).
ROUTEMATE_POLL_LIVE_SEC=60
ROUTEMATE_POLL_FAULTS_SEC=300
ROUTEMATE_POLL_DAILY_HOUR=4

# --- Linxup GPS / telematics (webhook push) ---
# Linxup is the fleet GPS provider. Unlike the Routemate poller, Linxup PUSHES
# telemetry to us: it POSTs each message to /api/eld/linxup/webhook — we never
# poll Linxup, so there is no base URL or poll cadence here.
# Master write switch. Leave false until the token is set and a real push has
# been verified. When false the webhook still ALWAYS enforces the token gate, but
# pushed positions are recognized/counted only, never written to live tracking or
# driver pay — so the feature ships dormant (matches ROUTEMATE_ENABLED).
LINXUP_ENABLED=false
# Shared secret Linxup presents on every push. The receiver accepts it as
# Authorization: Bearer <token>, X-Api-Key, X-Webhook-Token, or X-Linxup-Token
# header, or a ?token= query param. Blank → the webhook returns 503 (not
# configured). Never commit a real value.
LINXUP_WEBHOOK_TOKEN=
# Unit of the `speed` field on pushed Position messages; converted to m/s on
# ingest (downstream/tracking + the driver-pay travel gate expect m/s).
# mph | kmh | mps (default mph — US provider). LIVE-CAPTURE: confirm on 1st push.
LINXUP_SPEED_UNIT=mph

# --- ScanKit.io document scanning ---
# Powers the document scanner (driver POD/BOL, expense receipts, admin uploads)
# via POST /api/documents/scan — server-side only, never exposed to the client.
# Base URL is the production ScanKit API; override only for sandbox use.
SCANKIT_BASE_URL=https://api.scankit.io
# Issued by ScanKit (format sk_...). Sent as the Authorization: Bearer header.
SCANKIT_API_KEY=
# Master kill switch. Leave false until the API key is wired. When false (or the
# key is unset), POST /api/documents/scan returns 503 and the client scanner
# falls back to attaching the raw photo (receipts simply skip enhancement).
SCANKIT_ENABLED=false
# ScanKit is credit-billed: charged per successful scan (HTTP 2xx); 4xx errors
# like 402 are NOT billed and NOT retried. When credits run out the scan endpoint
# returns 402 and the driver app falls back to attaching the raw photo — the POD
# still uploads, just without crop/deskew/lighting enhancement. Setting
# SCANKIT_ENABLED=false fully disables scanning (endpoint returns 503 + the same
# raw-photo fallback). Recovery / credit top-up / key-rotation runbook:
# docs/runbooks/scankit-billing.md

# --- Automatic weekly invoice generation ---------------------------------
# Master kill switch for the Friday 4:00 PM America/New_York (DST-aware) batch
# that generates AND auto-submits every driver's weekly invoice (drivers kept
# forgetting to submit). Approval stays manual — nothing is auto-approved/paid.
# DEFAULT OFF (this moves money): stays dormant until explicitly enabled here,
# matching ROUTEMATE_ENABLED / SCANKIT_ENABLED. Enable with true/1/yes/on.
# On first enable it seeds a baseline so it never retroactively bills a past
# week — the first real run is the next Friday. A boot catch-up covers a restart
# across 4 PM; a week with drivers who worked-but-weren't-billed retries (bounded)
# and emails/notifies info@logisx.com with an ACTION-NEEDED summary.
INVOICE_AUTOGEN_ENABLED=false

# --- n8n -> app rate-con extraction + distance ----------------------------
# TWO endpoints accept EITHER N8N_WEBHOOK_SECRET or this extract-only secret:
#   POST /api/n8n/extract-pdf-via-gemini   (node "Extract via LogisX")
#   POST /api/n8n/load-distance            (node "Distance via LogisX")
# It exists because n8n Cloud cannot hand this workflow a usable credential
# through its API (create works, but read/list/projects are all 403 and an
# API-created credential isn't visible to the workflow owner), so the value must
# live in a node parameter — plaintext in the workflow JSON, readable by anyone
# with n8n access. Both nodes present the SAME value, so there is one thing to
# rotate.
#
# N8N_WEBHOOK_SECRET must NOT be used there: it also gates POST /api/n8n/job and
# POST /api/webhook/new-load, which CREATES LOADS. A leak of this scoped secret
# only burns Gemini credits and Distance Matrix elements on two rate-limited
# endpoints that write nothing — no sheet, no SQLite, no Drive.
#
# ⚠️ ROTATION IS A FOUR-STEP JOB AND THE ORDER MATTERS. The value now lives in
# three places, and a fourth that cannot be edited at all:
#   1. `Distance via LogisX` node parameter (n8n)
#   2. `Extract via LogisX` node parameter (n8n)
#   3. this variable in the VPS `.env`  ← change this LAST
#   4. n8n Cloud's `activeVersion` / `workflowPublishHistory` snapshot, readable
#      on GET /workflows/:id — deleting or editing a node does NOT revoke it.
# The server is what stops accepting the old value, and it stops the instant (3)
# changes — so doing (3) first 401s both nodes until the others catch up. Change
# the nodes first, the server last. Treat the history copy as permanently
# disclosed: rotation limits future use, it does not un-publish the old value.
# This is the same trap that made the deleted plaintext Google Maps key in
# `Get Distance Matrix` non-revocable by deletion.
#
# Interim, not permanent: once a Header Auth credential is created in the n8n UI,
# point both nodes at it and delete this.
N8N_EXTRACT_SECRET=

# --- Rate-con reconciliation (ingestion backstop) -------------------------
# Answers, from OUTSIDE the pipeline: did every rate-con email actually become a
# load? On 2026-08-05 two loads reached the mailbox and never reached the sheet —
# one during a Gemini outage, one because an n8n Filter node discarded a bad
# extraction with NO alert while still reporting success. Both were found by hand.
# Alerting on n8n's reject branch makes KNOWN failures loud; this catches the ones
# nobody has thought of (execution never starts, Gmail filter stops matching, n8n
# outage, workflow left deactivated) because it only compares email vs sheet.
#
# READ-ONLY on the mailbox (IMAP EXAMINE + BODY.PEEK): it must never set \Seen or
# \Flagged — n8n's Gmail Trigger selects on unread+starred, so a sweep that marked
# mail read would silently stop ingestion, i.e. cause the outage it detects.
# Alerts ONCE per load id, because a daily repeat of the same gap trains everyone
# to ignore the channel. Runs every 6h; also on demand via
# GET /api/admin/ratecon-reconcile (?dryRun=true reports without alerting).
# DEFAULT OFF, matching the other side-effectful integrations.
RATECON_RECONCILE_ENABLED=false
# ⚠️ NOW A FLOOR, NOT THE WINDOW. It used to be the entire lookback (capped at
# 60 days), which meant a gap older than it was not "harder to find" but
# structurally unreachable — and a sweep outage silently threw away the days
# nobody swept, because 14 days is always measured from *now*. That is how load
# 556354570 (16 Jun 2026) went eight weeks undetected. The window is now a
# HIGH-WATER MARK: each sweep reads everything since the last successful one,
# never less than this, never more than RATECON_RECONCILE_MAX_DAYS.
RATECON_RECONCILE_DAYS=14
RATECON_RECONCILE_MAX_DAYS=400
# Periodic full re-read, so anything the incremental chain dropped cannot stay
# dropped. The FIRST deep sweep is treated as a baseline: measured on production
# it finds 63 historical gaps against 0 in the 14-day window, so it is reported
# once as a labelled review list rather than as 63 fresh failures. Every load is
# still alerted exactly once, ever (ratecon_reconcile_alerts).
RATECON_RECONCILE_DEEP_DAYS=365
RATECON_RECONCILE_DEEP_EVERY_HOURS=168
# Where a load number may be read from. STAGED — subject, then the PDF
# attachment name, then the body, each only where the previous stage found
# nothing — so these can only ever see messages the subject scan left silent
# (12 of 687 on the real label) and cannot add a false positive to the rest.
# Measured on all 745 messages: the two stages add ONE candidate and the staging
# refuses one phantom (Trident names the real load in its subject but its
# attachment is an internal doc number). Set either to false to narrow back.
RATECON_RECONCILE_SCAN_FILENAMES=true
RATECON_RECONCILE_SCAN_BODY=true
RATECON_RECONCILE_MAILBOX=RATECONs

# --- Unusable-address alerting (the OTHER silent ingestion loss) -----------
# RATECON_RECONCILE_* answers "did the email become a load?". It cannot answer
# "is the load it became usable?", and on 2026-08-09 six email-ingested loads
# were found that had passed every gate carrying an address nothing could place —
# and therefore $0.00/mi. The clearest is 550303758 ($740, delivered April 2026),
# whose Job Tracking `Drop-off Address` cell is still EMPTY while `Drop-off Info`
# reads "SAMS CLUB 8244".
#
# n8n could not have caught it: its order is Validate Load ID -> JOB DETAILS
# ENTRY (which WRITES the Job Tracking row) -> Addresses Ready?, so the row is
# created before any address is examined, and `Addresses Ready?` only gates the
# distance branch. A guard downstream of the write cannot stop a bad write. The
# check therefore lives in POST /api/n8n/extract-pdf-via-gemini, which sees the
# fields before any sheet does.
#
# ⚠️ DEFAULTS ON, deliberately breaking the ships-dormant convention — same call
# as PII_MASK_ENABLED and for the same reason: this is a KILL SWITCH, not an
# enable switch. A defect detector that ships off is a defect detector that stays
# off, and the failure it exists to break is silence. Set to "false" only to
# quiet it deliberately. It never blocks an ingestion: a load with one bad field
# still reaches the sheet, because a load with a gap beats no load at all.
# One email + one dispatch notification per NEW bad load id (ratecon_extract_alerts);
# with no GMAIL_* configured it degrades to the notification and a console line.
RATECON_EXTRACT_ALERT_ENABLED=true
# Global ceiling on alerts per rolling 24 h, keyed on nothing the caller controls.
# ⚠️ The once-per-load dedupe is the PRIMARY control, but its key is Gemini's
# reading of the caller's PDF — and the n8n secret sits in plaintext in a node
# parameter — so a caller who can post PDFs can mint fresh keys by incrementing a
# load number. This cap is the control that still holds when that one doesn't.
# It matters because sendEmail is SHARED with onboarding, investor outreach and
# the invoice batch: exhausting Gmail's daily quota here would take ALL outbound
# app mail down, i.e. the abuse would silence the very channel this feature needs.
# Production produced 6 bad loads in 151, so 25/day is far above any real rate.
RATECON_EXTRACT_ALERT_MAX_PER_DAY=25
# Ceiling on the SECOND Gemini pass (the retry that recovers a missed address).
# ⚠️ pdfOcrLimiter caps REQUESTS per IP; it is not a spend cap. Whether the retry
# fires is decided by the CONTENT of the caller's PDF, so a rate con with no rate
# makes it fire every time — a deterministic 2x amplifier on a GEMINI_API_KEY that
# is shared across Alchemy projects and has already been exhausted once
# (2026-08-05), taking ingestion down. Per rolling 15 min, across all callers.
# Exceeding it is NOT an error: the first-pass fields still ship.
RATECON_RETRY_MAX_PER_WINDOW=20

# --- Monthly settlement close (investor payouts) --------------------------
# Master kill switch for the month-end close: a work month stays open for
# straggler receipts for `settlement_grace_days` (investor_config, default 7)
# after it ends, then finalizes automatically — freezing the payout figure and
# publishing the statement. Late receipts land in the prior month by themselves
# during the window instead of needing a hand-written adjustment; a receipt that
# misses it posts to the current open month and the closed month never moves.
# DEFAULT OFF (this freezes money figures and publishes documents): with it off,
# every guard is inert and the payout ledger behaves exactly as before.
# Enable with true/1/yes/on.
# On first enable it seeds a baseline lock over every period whose window has
# already passed, so nothing is retroactively re-opened and no month that is
# still legitimately inside its window gets closed early.
# Blocks "Mark Paid" until a period is finalized (that block is what ends the
# correction treadmill); reopening a settled payout stays exempt.
PERIOD_FINALIZE_ENABLED=false

# --- Investor maintenance notice -------------------------------------------
# While the app is mid-update, investors should see (a) a one-shot popup on
# login and (b) a persistent banner saying so — WITHOUT losing access to
# anything. This flag never gates a route or an action; it only controls
# whether GET /api/config/maintenance hands the SPA copy to render (the SPA
# then decides who's "in audience" and whether the popup has already been
# dismissed this session). The wording lives here, not in the client bundle,
# so it can be retuned in production without a redeploy — a `pm2 restart`
# picks up new copy, since, like every other env var in this file, it's read
# once at boot.
# DEFAULT OFF, matching every other flag here that changes what a user sees
# the instant it flips (ROUTEMATE_ENABLED / SCANKIT_ENABLED /
# INVOICE_AUTOGEN_ENABLED / PERIOD_FINALIZE_ENABLED): deploying this code must
# not, by itself, put a banner in front of an investor — an operator opts in
# only once there is a real maintenance window worth announcing.
# WARNING: GET /api/config/maintenance is deliberately unauthenticated (same as
# /api/config/maps-key, so the SPA can fetch it before the session resolves),
# which means anyone who curls it reads this copy while the flag is on. That is
# fine for generic wording and strictly less sensitive than the Maps key — but
# it does mean the words below must never name a client, a dollar amount, or a
# root cause. Write them as if they were on a public status page, because they
# effectively are.
MAINTENANCE_NOTICE_ENABLED=false
# The BANNER headline only. Renders uppercase at font-weight 800, so it eats
# vertical space fast — keep it to a few words, not a sentence. Hard cap 80
# characters; anything longer is truncated at a word boundary (no "…" appended)
# and the server logs a [maintenance-notice] warning at boot.
MAINTENANCE_NOTICE_TITLE=SYSTEM UPDATE IN PROGRESS
# The LOGIN POPUP heading — separate from the banner on purpose. The client
# asked for two different lines: a banner saying the system is updating, and a
# popup saying the application is under maintenance. One shared string could
# only satisfy one of them, and the banner uppercases whatever it is given, so
# putting a full sentence in MAINTENANCE_NOTICE_TITLE would shout it across the
# top of the page. Not uppercased here. Same 80-char cap. Blank falls back to
# MAINTENANCE_NOTICE_TITLE.
MAINTENANCE_NOTICE_MODAL_TITLE=Application is currently under maintenance
# Banner/popup body copy. Keep it short: say the portal is being updated,
# that figures may shift while it is, and that nothing is locked — that last
# part is the whole point, since the client explicitly does not want
# investors to think they've been shut out.
# "Short" is enforced, not just advised: hard cap 400 characters, truncated at
# a word boundary past that (never rejected — a notice that fails closed during
# an incident is worse than a shortened one). The cap exists because the banner
# is sticky: roughly 1,300 characters fills a phone viewport and pins the banner
# over the whole page, which is exactly the "knocked out of the portal" feeling
# the client said to avoid. Aim for the ~170 characters of the default below.
MAINTENANCE_NOTICE_MESSAGE=The portal is being updated behind the scenes right now — some figures may shift while we finish. You're welcome to keep using everything as normal; nothing here is locked.
# The client's own wording for the fine-print line under the message —
# leave verbatim unless the client asks otherwise. Hard cap 200 characters,
# same word-boundary truncation as the other two.
MAINTENANCE_NOTICE_DISCLAIMER=The final settlements are still being calculated.
# investor | all — anything else (typo, blank) falls back to investor.
# 'investor' also covers a Super Admin sitting inside the read-only
# investor-portal preview, so admins previewing that view see exactly what
# the investor sees. 'all' additionally surfaces the notice to Dispatcher/
# Super Admin's own screens, which is rarely what's wanted.
MAINTENANCE_NOTICE_AUDIENCE=investor
# Any string. Bumping it re-shows the popup to everyone who already
# dismissed it this session — the client keys its per-session dismissal flag
# off this exact value, so change it (not just the message) when a dismissed
# notice needs to resurface.
# It lands inside a browser sessionStorage key, so it is sanitized hardest of
# the four: everything outside A-Z a-z 0-9 . _ - is stripped, then capped at 32
# characters. Keep it plain (2, 2026-08-06, aug-window) — if a "bump" differs
# from the previous value only in stripped characters it sanitizes to the same
# string and the popup will NOT resurface.
MAINTENANCE_NOTICE_VERSION=1

# --- GPS geofence radius -----------------------------------------------------
# How close an ELD ping must be to a load's mapped pickup / delivery point for
# the status to advance automatically (At Shipper, In Transit on departure,
# At Receiver). Applies to BOTH zones. Metres.
# 3218.69 m = 2 miles, set by the client 2026-08-06. The prior 1000 m was tight:
# of the first two automatic status changes ever recorded, one fired at 881 m —
# it only just qualified. Wider absorbs imprecise rate-con geocodes and big yards.
# Leave unset to take that default; the value only needs setting to override it.
# 0, negative and non-numeric all fall back to the default — a 0 radius would
# disable every geofence silently, which is precisely the bug this feature spent
# months having.
# ⚠️ Area scales with the SQUARE of this (1000 -> 3218.69 m is 3.2x the radius
# but 10.4x the area). Raising it further makes the arrival hysteresis weaker (a
# highway drive-by spends more consecutive fixes inside the zone) and pushes the
# displayed shipper detention window wider at both ends — arrival is stamped
# earlier, departure later. Nothing bills off those timestamps today.
GEOFENCE_RADIUS_M=3218.69
# Arrival speed ceiling, metres/second. A truck cannot arrive at highway speed,
# so a ping faster than this never triggers At Shipper / At Receiver.
# Default 4.5 m/s (~10 mph). Departure is exempt — being in motion IS its signal.
# Why it exists: the arrival check also wants two consecutive fixes inside the
# zone, which was a real filter at 1000 m (a 2 km chord is barely two fixes at
# 60 mph on a 60 s poll) but not at 3218.69 m, where the chord is 6.44 km — about
# four fixes — so a truck merely passing a shipper on the freeway satisfied it.
# A speed test does not weaken as the radius grows, so it stays correct on a
# retune. It also sharpens detention: arrival now stamps when the truck slows at
# the site, not when it first crosses a line two miles out.
# Looser than the 5 mph "moving" threshold on purpose, so a truck still rolling
# through the gate qualifies on the first fix rather than waiting a poll.
# Non-numeric, 0 and negative fall back to the default. A ping with NO speed
# always passes (undefined/"abc" coerce to NaN, null/"" to 0 — all compare
# false against the ceiling): a missing field must never cause a missed arrival.
GEOFENCE_ARRIVE_MAX_SPEED_MPS=4.5

# --- Fuel gallons recovery (reads missing volume off stored receipt images) ---
# Gates the APPLY verb of /api/admin/fuel-gallons-recovery only. The PROPOSE verb
# (GET) works regardless, so a run can be inspected in production — hit rate,
# refusals, exact gallons per receipt — before anything writes to a finance row.
# Default off: this UPDATEs expenses.gallons, which feeds cost-per-gallon,
# cost-per-mile and the tank-to-tank MPG a driver plans a fuel stop against.
# Fully reversible when it has run:
#   UPDATE expenses SET gallons = 0, gallons_source = '' WHERE gallons_source = 'ocr';
# Needs GEMINI_API_KEY (503 without it). Each call bills up to 25 Gemini vision
# requests; fuelGallonsLimiter caps both verbs at 6 per 15 min combined.
FUEL_GALLONS_RECOVERY_ENABLED=false

# --- Fuel range buffer + sensor-dropout handling ---
# ⚠️ FUEL_RESERVE_MILES IS A SAFETY MARGIN AND IT WAS REDUCED ON PURPOSE.
# The trip verdict ("can this truck finish the route?") is judged against
# route + this buffer. It was a hardcoded 50 miles with a 10% proportional term;
# after a truck ran dry on 2026-08-17 the client asked for "a 15 mile buffer",
# was told that is 35 miles LESS margin than before, and kept 15.
# FUEL_RESERVE_FRACTION is 0 so the buffer is literally 15 — at the old 0.10 a
# 215-mile route would compute max(15, 21.5) = 22, i.e. quietly not 15.
# Raise either with a `pm2 restart`; no redeploy. Anything non-numeric or
# negative falls back to the shipped default, so a typo can never shrink it.
FUEL_RESERVE_MILES=15
FUEL_RESERVE_FRACTION=0

# The fuel sensor on this fleet drops to 0 WHILE DRIVING — measured 47% of
# readings on one truck, in dropouts lasting hours. So a 0 is not trusted at
# face value: the last credible reading is carried forward minus the fuel burned
# since (from the odometer delta), which can only ever LOWER the estimate.
# FUEL_CARRY_LOOKBACK_HOURS bounds how far back SQL may look for that reading.
# FUEL_CARRY_MAX_HOURS bounds how OLD it may be before we refuse to carry it at
# all and report `stale` with no range. That second one is load-bearing: a dead
# ELD freezes the odometer too, so without it a three-day-old reading subtracts
# zero burn and reports a confident full tank. Keep it well above a real dropout
# (~4 h) and well below "the device is gone".
FUEL_CARRY_LOOKBACK_HOURS=168
FUEL_CARRY_MAX_HOURS=12

# --- PII masking on read (SSN / EIN / bank numbers) ---
# ⚠️ THE ONE FLAG HERE THAT DEFAULTS **ON**. Every other flag in this file ships
# dormant because enabling it moves money, sends mail, or spends on a metered
# API — for those, off is the safe direction. This one withholds SSNs, tax ids,
# bank routing/account numbers and licence numbers from API responses, and for a
# control like that "off" IS the failure mode. A masking layer that ships
# disabled is not a control, it is a comment.
#
# So this is a KILL SWITCH, not an enable switch. Set it to false and
# `pm2 restart logistics-app` if masking ever obstructs a real admin workflow —
# that restores the previous behaviour byte for byte, with no redeploy.
# (Verified: with the flag off, GET /api/applications/:id returns the raw SSN
# exactly as it did before this change.)
#
# It is safe to default on because masking removes no CAPABILITY. The full
# values stay one click away behind two audited, rate-limited routes:
#   GET /api/applications/:id/sensitive            (SSN + licence)
#   GET /api/investor-applications/:id/sensitive   (EIN/SSN + routing + account)
# Each writes an audit_trail row. That is the actual point: `super_admin` is a
# SHARED login, so no control can say WHICH person read a value — but a reveal
# can at least be an event on the record rather than a silent side effect of
# opening a page.
#
# ⚠️ This flag does NOT govern the ownership guard on signed onboarding PDFs
# (uploads/onboarding-signed, uploads/investor-onboarding-signed). That is a
# straight vulnerability fix — any authenticated Driver could previously read
# any other person's W-9 by guessing the filename — and it is unconditional by
# design. Turning masking off does not re-open it.
PII_MASK_ENABLED=true
